---
import { t, localizedPath } from '@hosteleria/i18n-utils';
import type { LocaleRef, Restaurant } from '@hosteleria/sanity-client';
import IconClose from '@hosteleria/ui/icons/IconClose.astro';
import CtaButton from './CtaButton.astro';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
  activeLocales: LocaleRef[];
  waHref: string;
  whatsappRaw: string;
  bookingPhone: string;
  bookingEmail: string;
  hrefPrefix?: string;
  langSwitcherPath?: string;
}

const {
  restaurant,
  locale,
  defaultLocale,
  activeLocales,
  waHref,
  whatsappRaw,
  bookingPhone,
  bookingEmail,
  hrefPrefix = '',
  langSwitcherPath = '/'
} = Astro.props;

const nav = restaurant.textosNav ?? {};

const A11Y: Record<string, { close: string; menu: string }> = {
  es: { close: 'Cerrar menú', menu: 'Menú' },
  en: { close: 'Close menu', menu: 'Menu' },
  ca: { close: 'Tancar menú', menu: 'Menú' }
};
const a11y = A11Y[locale] ?? A11Y.es;

const localesUi = activeLocales.length
  ? activeLocales
  : [{ codigo: defaultLocale, nombre: defaultLocale }];

const partes = restaurant.nombre.match(/^(Casa|La|El)?\s?(.*)$/);
const brandStart = partes?.[1] ?? '';
const brandRest = partes?.[2] ?? restaurant.nombre;

// Sello "Casa desde {año}" desde Sanity — mismo patrón que el hero
const anyo = restaurant.anyoFundacion;
const casaDesde = anyo
  ? locale === 'en' ? `House since ${anyo}` : `Casa desde ${anyo}`
  : null;

// Links de navegación (Reservar se muestra aparte como CTA destacado)
const links = [
  { href: `${hrefPrefix}#about`, label: t(nav.linkLocal, locale, defaultLocale) || 'Historia' },
  { href: `${hrefPrefix}#plates`, label: t(nav.linkCocina, locale, defaultLocale) || 'Carta' },
  { href: `${hrefPrefix}#wines`, label: t(nav.linkVinos, locale, defaultLocale) || 'Vinos' },
  { href: `${hrefPrefix}#gallery`, label: t(nav.linkGaleria, locale, defaultLocale) || 'Galería' }
];
const reservarLabel = t(nav.linkReservar, locale, defaultLocale) || 'Reservar';

const CONTACT_LABELS: Record<string, { tel: string; wa: string; mail: string }> = {
  es: { tel: 'Teléfono', wa: 'WhatsApp', mail: 'Email' },
  en: { tel: 'Phone', wa: 'WhatsApp', mail: 'Email' },
  ca: { tel: 'Telèfon', wa: 'WhatsApp', mail: 'Email' }
};
const cLabels = CONTACT_LABELS[locale] ?? CONTACT_LABELS.es;
---

<!--
  Pubilla MobileOverlay: overlay con lenguaje editorial "recetario".
  Header con brand + sello "Casa desde 1926", links numerados (01, 02...)
  con separadores punteados, CTA destacado como botón grande, footer con
  contact labels manuscritos y asterisco decorativo.
-->
<div
  id='mobileOverlay'
  aria-hidden='true'
  data-open='false'
  class="fixed inset-0 z-[100] flex flex-col overflow-y-auto bg-bg
         py-5 px-(--gap) pb-10
         opacity-0 pointer-events-none -translate-y-3
         transition-[opacity,transform] duration-[260ms] ease-out
         data-[open='true']:opacity-100 data-[open='true']:pointer-events-auto data-[open='true']:translate-y-0
         motion-reduce:transition-none motion-reduce:duration-0"
>
  <!-- Header: brand + sello + close -->
  <div class='flex justify-between items-start pb-6 border-b border-line-strong/40'>
    <div class='flex flex-col gap-1'>
      <span class='font-serif text-ink font-medium text-[22px] leading-none'>
        {
          brandStart ? (
            <>
              {brandStart}
              <em class='italic text-accent'>{brandRest}</em>
            </>
          ) : (
            restaurant.nombre
          )
        }
      </span>
      {
        casaDesde && (
          <span class='font-serif italic text-accent-alt text-[13px] mt-1'>
            {casaDesde}
          </span>
        )
      }
    </div>
    <button
      id='mobileCloseBtn'
      aria-label={a11y.close}
      class='flex items-center justify-center w-11 h-11 -mr-2.5 bg-transparent border-none text-ink cursor-pointer transition-[background-color,transform] duration-300 hover:bg-surface hover:rotate-90'
    >
      <IconClose />
    </button>
  </div>

  <!-- Separador ornamental con asterisco -->
  <div
    aria-hidden='true'
    class='flex items-center justify-center gap-3 py-5 text-accent-alt'
  >
    <span class='flex-1 h-px bg-line-strong/50'></span>
    <span class='font-serif text-[18px] leading-none'>∗</span>
    <span class='flex-1 h-px bg-line-strong/50'></span>
  </div>

  <!-- Links numerados 01, 02... con staggering -->
  <nav aria-label={a11y.menu} class='flex-1 flex flex-col justify-center py-4'>
    {
      links.map((link, i) => (
        <a
          href={link.href}
          style={`--d: ${0.05 + i * 0.04}s`}
          class="group flex items-baseline gap-4 py-4 border-b border-line
                 opacity-0 translate-x-[-8px]
                 transition-[opacity,transform] duration-[220ms] ease-out
                 hover:pl-2 cursor-pointer
                 group-data-[open='true']/overlay:opacity-100 group-data-[open='true']/overlay:translate-x-0 group-data-[open='true']/overlay:[transition-delay:var(--d)] group-data-[open='true']/overlay:duration-[380ms]
                 motion-reduce:transition-none motion-reduce:opacity-100 motion-reduce:translate-x-0"
        >
          <span class='font-serif italic text-accent-alt text-[16px] tabular-nums shrink-0'>
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class='font-serif text-ink font-light text-[clamp(30px,7vw,40px)] leading-none group-hover:text-accent transition-colors duration-300'>
            {link.label}
          </span>
        </a>
      ))
    }
  </nav>

  <!-- CTA destacado "Reservar" — aparece con delay tras los links, sale simultáneo -->
  <div
    class="reveal-cta flex justify-center pt-6 pb-6
           opacity-0 translate-y-3
           transition-[opacity,transform] duration-[220ms] ease-out
           group-data-[open='true']/overlay:opacity-100 group-data-[open='true']/overlay:translate-y-0
           group-data-[open='true']/overlay:[transition-delay:0.25s] group-data-[open='true']/overlay:duration-[380ms]
           motion-reduce:transition-none motion-reduce:opacity-100 motion-reduce:translate-y-0"
  >
    <CtaButton href={`${hrefPrefix}#book`} class='w-full justify-center'>
      {reservarLabel}
    </CtaButton>
  </div>

  <!-- Separador ornamental -->
  <div
    aria-hidden='true'
    class='flex items-center justify-center gap-3 py-4 text-accent-alt'
  >
    <span class='flex-1 h-px bg-line-strong/50'></span>
    <span class='font-serif text-[16px] leading-none'>∗</span>
    <span class='flex-1 h-px bg-line-strong/50'></span>
  </div>

  <!-- Footer: idiomas + contacto con labels manuscritos -->
  <div class='flex flex-col gap-6 pt-2'>
    {
      localesUi.length > 1 && (
        <div class='flex items-center gap-3'>
          <span class='font-sans uppercase text-[10px] tracking-[0.3em] text-dim font-semibold'>
            {locale === 'en' ? 'Language' : locale === 'ca' ? 'Idioma' : 'Idioma'}
          </span>
          <span class='font-serif text-accent-alt text-[14px] leading-none'>∗</span>
          <div
            aria-label='Idioma'
            class='flex gap-2 font-sans font-medium uppercase text-[11px] tracking-[0.26em] text-dim'
          >
            {localesUi.map((l, i) => (
              <>
                {i > 0 && <span class='text-dim opacity-50 -mx-0.5 select-none'>·</span>}
                <a
                  href={
                    l.codigo === locale
                      ? '#'
                      : localizedPath(langSwitcherPath, l.codigo, defaultLocale)
                  }
                  class:list={[
                    'py-1 transition-colors duration-300',
                    l.codigo === locale
                      ? 'text-accent pointer-events-none'
                      : 'hover:text-ink cursor-pointer'
                  ]}
                  aria-current={l.codigo === locale ? 'true' : undefined}
                >
                  {l.codigo.toUpperCase()}
                </a>
              </>
            ))}
          </div>
        </div>
      )
    }

    <div class='flex flex-col gap-3'>
      {
        bookingPhone && (
          <a
            href={`tel:${bookingPhone}`}
            class='group flex items-baseline gap-3 transition-colors duration-300 hover:text-accent cursor-pointer'
          >
            <span class='font-serif italic text-accent-alt text-[13px] shrink-0 min-w-[70px]'>
              {cLabels.tel}
            </span>
            <span class='font-serif text-ink-soft text-[15px] group-hover:text-accent transition-colors'>
              {bookingPhone}
            </span>
          </a>
        )
      }
      {
        waHref && (
          <a
            href={waHref}
            target='_blank'
            rel='noopener'
            class='group flex items-baseline gap-3 transition-colors duration-300 hover:text-accent cursor-pointer'
          >
            <span class='font-serif italic text-accent-alt text-[13px] shrink-0 min-w-[70px]'>
              {cLabels.wa}
            </span>
            <span class='font-serif text-ink-soft text-[15px] group-hover:text-accent transition-colors'>
              {whatsappRaw}
            </span>
          </a>
        )
      }
      {
        bookingEmail && (
          <a
            href={`mailto:${bookingEmail}`}
            class='group flex items-baseline gap-3 transition-colors duration-300 hover:text-accent cursor-pointer'
          >
            <span class='font-serif italic text-accent-alt text-[13px] shrink-0 min-w-[70px]'>
              {cLabels.mail}
            </span>
            <span class='font-serif text-ink-soft text-[15px] group-hover:text-accent transition-colors'>
              {bookingEmail}
            </span>
          </a>
        )
      }
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const hamburger = document.getElementById('hamburgerBtn');
    const closeBtn = document.getElementById('mobileCloseBtn');
    const overlay = document.getElementById('mobileOverlay');
    if (!hamburger || !overlay) return;

    // El overlay usa data-open (Tailwind data-[open=true]:). Además:
    // - `group/overlay` en el div padre + `group-data-[open='true']/overlay:` en los links → staggering al abrir.
    overlay.classList.add('group/overlay');

    const setOpen = open => {
      overlay.dataset.open = open ? 'true' : 'false';
      document.body.classList.toggle('overlay-open', open);
      hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
      overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (open) closeBtn?.focus();
      else hamburger?.focus();
    };

    hamburger.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && overlay.dataset.open === 'true') setOpen(false);
    });

    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.onclick = e => {
        const target = a.getAttribute('href');
        if (target === '#') return;
        const el = document.querySelector(target);
        if (!el) return;
        e.preventDefault();
        const wasOpen = overlay.dataset.open === 'true';
        if (wasOpen) setOpen(false);
        setTimeout(
          () => el.scrollIntoView({ behavior: 'smooth', block: 'start' }),
          wasOpen ? 350 : 0
        );
      };
    });
  })();
</script>
