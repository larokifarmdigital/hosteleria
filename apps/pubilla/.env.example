# Base del api propio. Si está, la landing lee de ahí y no de Sanity.
CONTENT_API_URL=

# ID del proyecto Sanity (mismo que apps/studio)
SANITY_PROJECT_ID=

# Dataset (por defecto "production")
SANITY_DATASET=production

# Slug del restaurante que consume esta app (debe existir como doc `restaurante` en Sanity)
RESTAURANT_SLUG=pubilla
