---
/**
 * Guixot CTA — rectangular filled burgundy con acabado tavern.
 * Distinto al pill dorado de Casabella. Substancial, brochazo tradicional.
 */
interface Props {
  target?: '_blank' | '_self';
  rel?: string;
  href?: string;
  type?: 'submit' | 'button';
  class?: string;
}
const { href, type = 'button', target, rel, class: cls = '' } = Astro.props;

const base = [
  'inline-flex items-center gap-3 py-3.5 px-8',
  'bg-accent text-bg rounded-sm',
  'font-sans font-semibold uppercase text-[12px] tracking-[0.24em]',
  'cursor-pointer border border-accent',
  'shadow-[0_6px_20px_-6px_rgb(30_58_95/0.4)]',
  'transition-[background-color,border-color,transform,box-shadow] duration-[350ms] ease-out',
  'hover:bg-accent-hover hover:border-accent-hover hover:-translate-y-0.5',
  'hover:shadow-[0_12px_28px_-6px_rgb(30_58_95/0.55)]',
  '[&>.arrow]:transition-transform [&>.arrow]:duration-[350ms] hover:[&>.arrow]:translate-x-1',
];
---

{href ? (
  <a href={href} target={target} rel={rel} class:list={[...base, cls]}>
    <slot />
    <span class="arrow">→</span>
  </a>
) : (
  <button type={type} class:list={[...base, cls]}>
    <slot />
    <span class="arrow">→</span>
  </button>
)}
