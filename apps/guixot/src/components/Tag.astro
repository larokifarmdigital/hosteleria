---
/**
 * Tag — etiqueta propia de Guixot: texto en mayúsculas espaciadas, en navy.
 */
interface Props {
  class?: string;
  as?: 'span' | 'div' | 'p';
}
const { class: cls = '', as: Tag = 'span' } = Astro.props;
---

<Tag
  class:list={[
    cls,
    'inline-flex items-center text-accent font-semibold uppercase text-[12px] tracking-[0.26em]'
  ]}
>
  <slot />
</Tag>
