---
/**
 * Tag — label decorativo específico de Guixot: solo texto uppercase en accent.
 * Sin rule/línea decorativa. Distinto del `Eyebrow` de Casabella.
 */
interface Props {
  class?: string;
  as?: 'span' | 'div' | 'p';
}
const { class: cls = '', as: Tag = 'span' } = Astro.props;
---

<Tag
  class:list={[
    cls,
    'inline-flex items-center text-accent font-medium uppercase text-[11px] tracking-[0.3em]'
  ]}
>
  <slot />
</Tag>
