---
import { t, localizedPath } from '@hosteleria/i18n-utils';
import type { LocaleRef, Restaurant } from '../lib/queries';
import IconHamburger from '@hosteleria/ui/icons/IconHamburger.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
  activeLocales: LocaleRef[];
  hrefPrefix?: string;
  langSwitcherPath?: string;
  forceScrolled?: boolean;
}

const {
  restaurant,
  locale,
  defaultLocale,
  activeLocales,
  hrefPrefix = '',
  langSwitcherPath = '/',
  forceScrolled = false
} = Astro.props;

const nav = restaurant.textosNav ?? {};
const bookingAction = resolveBookingAction(restaurant, locale, hrefPrefix);

const localesUi = activeLocales.length
  ? activeLocales
  : [{ codigo: defaultLocale, nombre: defaultLocale }];

const partes = restaurant.nombre.match(/^(Casa|La|El)?\s?(.*)$/);
const brandStart = partes?.[1] ?? '';
const brandRest = partes?.[2] ?? restaurant.nombre;

const scrolledAttr = forceScrolled ? 'true' : 'false';

const A11Y: Record<string, { openMenu: string; language: string }> = {
  es: { openMenu: 'Abrir menú', language: 'Idioma' },
  en: { openMenu: 'Open menu', language: 'Language' },
  ca: { openMenu: 'Obrir menú', language: 'Idioma' }
};
const a11y = A11Y[locale] ?? A11Y.es;
const openMenuLabel = a11y.openMenu;

const links = [
  { href: `${hrefPrefix}#about`, label: t(nav.linkLocal, locale, defaultLocale) || 'Historia' },
  { href: `${hrefPrefix}#plates`, label: t(nav.linkCocina, locale, defaultLocale) || 'Carta' },
  { href: `${hrefPrefix}#wines`, label: t(nav.linkVinos, locale, defaultLocale) || 'Vinos' },
  { href: `${hrefPrefix}#gallery`, label: t(nav.linkGaleria, locale, defaultLocale) || 'Galería' }
];
---

<!--
  Nav: casi transparente sobre el hero full-bleed (deja ver la imagen),
  ivory opaco al scroll. Texto blanco sobre imagen, ink al scrollear.
-->
<nav
  id='nav'
  data-scrolled={scrolledAttr}
  data-force-scrolled={forceScrolled ? '1' : undefined}
  class:list={[
    'fixed z-50 inset-x-0 top-0 flex items-center justify-between gap-8',
    'py-4 px-(--gap)',
    'backdrop-blur-[20px] backdrop-saturate-[160%]',
    'bg-[rgb(245_240_230/0.11)] border-b border-white/10',
    'transition-[background-color,padding,border-color,box-shadow] duration-[350ms] ease-out',
    "data-[scrolled='true']:py-3 data-[scrolled='true']:bg-[rgb(245_240_230/0.92)] data-[scrolled='true']:border-b-line data-[scrolled='true']:shadow-[0_1px_0_rgb(26_29_36/0.03)]"
  ]}
>
  <a
    href={hrefPrefix || '#top'}
    data-scrolled={scrolledAttr}
    class="font-serif font-normal leading-none tracking-[-0.005em] shrink-0 text-[clamp(24px,2.4vw,32px)] transition-colors duration-300
           text-white data-[scrolled='true']:text-ink"
  >
    {brandStart ? (
      <>
        {brandStart}
        <em
          data-scrolled={scrolledAttr}
          class="italic font-normal transition-colors duration-300
                 text-[color:var(--color-accent-alt)] data-[scrolled='true']:text-accent"
        >
          {brandRest}
        </em>
      </>
    ) : (
      restaurant.nombre
    )}
  </a>

  <div class='hidden items-center gap-[clamp(22px,3vw,40px)] min-[961px]:flex'>
    <ul class='flex list-none gap-[clamp(20px,2.4vw,34px)] font-sans font-medium uppercase text-[11.5px] tracking-[0.22em]'>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-scrolled={scrolledAttr}
            class="py-1 transition-colors duration-300
                   text-white/85 hover:text-white
                   data-[scrolled='true']:text-muted data-[scrolled='true']:hover:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    {localesUi.length > 1 && (
      <details class='lang-dropdown group relative' aria-label={a11y.language}>
        <summary
          data-scrolled={scrolledAttr}
          class="list-none [&::-webkit-details-marker]:hidden cursor-pointer
                 inline-flex items-center gap-2 py-1.5 px-3 rounded-sm border backdrop-blur-md
                 font-sans font-semibold uppercase text-[11px] tracking-[0.22em]
                 transition-[background-color,border-color,color] duration-300
                 border-white/30 text-white bg-black/25 hover:bg-black/35
                 data-[scrolled='true']:border-line data-[scrolled='true']:text-ink data-[scrolled='true']:bg-bg data-[scrolled='true']:hover:bg-bg-2"
        >
          <span>{locale.toUpperCase()}</span>
          <svg width='10' height='10' viewBox='0 0 12 12' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='transition-transform duration-300 group-open:rotate-180 opacity-80'>
            <path d='M3 4.5L6 7.5L9 4.5' />
          </svg>
        </summary>
        <div class='absolute right-0 top-[calc(100%+6px)] min-w-[110px] bg-bg border border-line rounded-sm overflow-hidden shadow-[0_10px_28px_-14px_rgb(30_58_95/0.28)] py-1'>
          {localesUi.map((l) => (
            <a
              href={
                l.codigo === locale
                  ? '#'
                  : localizedPath(langSwitcherPath, l.codigo, defaultLocale)
              }
              class:list={[
                'block px-4 py-2 font-sans font-semibold uppercase text-[11px] tracking-[0.22em] transition-colors duration-200',
                l.codigo === locale
                  ? 'text-accent bg-bg-2 pointer-events-none'
                  : 'text-muted hover:text-ink hover:bg-bg-2 cursor-pointer'
              ]}
              aria-current={l.codigo === locale ? 'true' : undefined}
            >
              {l.codigo.toUpperCase()}
            </a>
          ))}
        </div>
      </details>
    )}

    {bookingAction && (
      <a
        href={bookingAction.href}
        target={bookingAction.external ? '_blank' : undefined}
        rel={bookingAction.external ? 'noopener' : undefined}
        class='inline-flex items-center gap-2.5 py-2.5 px-5 bg-accent text-bg border border-accent rounded-sm font-sans font-semibold uppercase text-[11px] tracking-[0.22em] whitespace-nowrap cursor-pointer shadow-[0_6px_18px_-6px_rgb(30_58_95/0.55)] transition-[background-color,border-color,transform,box-shadow] duration-300 hover:bg-accent-hover hover:border-accent-hover hover:-translate-y-px hover:shadow-[0_10px_24px_-8px_rgb(30_58_95/0.65)]'
      >
        {bookingAction.label ?? t(nav.linkReservar, locale, defaultLocale) ?? 'Reservar'}
      </a>
    )}
  </div>

  <button
    id='hamburgerBtn'
    aria-label={openMenuLabel}
    aria-expanded='false'
    aria-controls='mobileOverlay'
    data-scrolled={scrolledAttr}
    class="flex items-center justify-center w-11 h-11 -mr-2.5 bg-transparent border-none rounded-full cursor-pointer transition-colors duration-300 min-[961px]:hidden [&>svg]:block
           text-white hover:bg-white/10
           data-[scrolled='true']:text-ink data-[scrolled='true']:hover:bg-surface"
  >
    <IconHamburger />
  </button>
</nav>

<script is:inline>
  (function () {
    const nav = document.getElementById('nav');
    if (!nav) return;

    if (nav.dataset.forceScrolled !== '1') {
      // Sincronización data-scrolled entre nav y descendientes que lo declaran.
      const syncChildren = (val) => {
        nav.querySelectorAll('[data-scrolled]').forEach((el) => {
          if (el !== nav) el.dataset.scrolled = val;
        });
      };
      const onScroll = () => {
        const val = window.scrollY > 40 ? 'true' : 'false';
        nav.dataset.scrolled = val;
        syncChildren(val);
      };
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
    }

    // Cierra el dropdown de idiomas al hacer click fuera o presionar Escape.
    const dropdown = nav.querySelector('.lang-dropdown');
    if (dropdown) {
      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target)) dropdown.removeAttribute('open');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') dropdown.removeAttribute('open');
      });
    }
  })();
</script>
