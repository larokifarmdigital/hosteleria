---
import { t, localizedPath } from '@hosteleria/i18n-utils';
import { splitLastWord } from '@hosteleria/utils';
import type { LocaleRef, Restaurant } from '@hosteleria/sanity-client';
import IconClose from '@hosteleria/ui/icons/IconClose.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
  activeLocales: LocaleRef[];
  waHref: string;
  whatsappRaw: string;
  bookingPhone: string;
  bookingEmail: string;
  hrefPrefix?: string;
  langSwitcherPath?: string;
}

const {
  restaurant,
  locale,
  defaultLocale,
  activeLocales,
  waHref,
  whatsappRaw,
  bookingPhone,
  bookingEmail,
  hrefPrefix = '',
  langSwitcherPath = '/'
} = Astro.props;

const nav = restaurant.textosNav ?? {};

const A11Y: Record<string, { close: string; menu: string; language: string }> = {
  es: { close: 'Cerrar menú', menu: 'Menú', language: 'Idioma' },
  en: { close: 'Close menu', menu: 'Menu', language: 'Language' },
  ca: { close: 'Tancar menú', menu: 'Menú', language: 'Idioma' }
};
const a11y = A11Y[locale] ?? A11Y.es;

const localesUi = activeLocales.length
  ? activeLocales
  : [{ codigo: defaultLocale, nombre: defaultLocale }];

const partes = restaurant.nombre.match(/^(Casa|La|El)?\s?(.*)$/);
const brandStart = partes?.[1] ?? '';
const brandRest = partes?.[2] ?? restaurant.nombre;

const links = [
  { href: `${hrefPrefix}#about`, label: t(nav.linkLocal, locale, defaultLocale) || 'Historia' },
  { href: `${hrefPrefix}#plates`, label: t(nav.linkCocina, locale, defaultLocale) || 'Carta' },
  { href: `${hrefPrefix}#wines`, label: t(nav.linkVinos, locale, defaultLocale) || 'Vinos' },
  { href: `${hrefPrefix}#gallery`, label: t(nav.linkGaleria, locale, defaultLocale) || 'Galería' }
];
const bookingAction = resolveBookingAction(restaurant, locale, hrefPrefix);
const reservarLabel = t(nav.linkReservar, locale, defaultLocale) || 'Reservar';
---

<!--
  Guixot MobileOverlay v3: brasserie parisina editorial. Rediseño con más
  jerarquía visual y aire, manteniendo cream + navy.

  Layout:
    · Header eyebrow + brand + X, hairline sutil
    · Nav como "carta": cada link con número serif brass a la izq + label
      serif ink (última palabra italic accent), flecha en hover
    · CTA outline navy con flecha
    · Footer: eyebrow "Contacto" + links serif alineados, idiomas
      con underline sutil en el activo
-->
<div
  id='mobileOverlay'
  aria-hidden='true'
  data-open='false'
  class="fixed inset-0 z-[100] flex flex-col overflow-y-auto bg-bg
         py-6 px-(--gap) pb-10
         opacity-0 pointer-events-none
         transition-opacity duration-[220ms] ease-out
         data-[open='true']:opacity-100 data-[open='true']:pointer-events-auto
         motion-reduce:transition-none motion-reduce:duration-0"
>
  <!-- Header: brand centrado + close en corner -->
  <div class='flex justify-between items-center pb-5'>
    <span class='font-serif text-ink font-medium text-[22px] leading-none tracking-tight'>
      {
        brandStart ? (
          <>
            {brandStart}{' '}
            <em class='italic text-accent font-normal'>{brandRest}</em>
          </>
        ) : (
          restaurant.nombre
        )
      }
    </span>
    <button
      id='mobileCloseBtn'
      aria-label={a11y.close}
      class='flex items-center justify-center w-11 h-11 -mr-2.5 bg-transparent border border-line-strong/50 rounded-full text-ink cursor-pointer transition-[color,border-color,transform] duration-300 hover:text-accent hover:border-accent hover:rotate-90'
    >
      <IconClose />
    </button>
  </div>

  <!-- Nav: links serif centrados con hairline entre secciones. Sin números,
       sin flechas — más editorial y limpio. Toda la lista respira en el
       centro del viewport. -->
  <nav aria-label={a11y.menu} class='flex-1 flex flex-col justify-center'>
    <ul class='flex flex-col text-center border-y border-line-strong/25 divide-y divide-line-strong/20'>
      {
        links.map(link => {
          const { head, tail } = splitLastWord(link.label);
          return (
            <li>
              <a
                href={link.href}
                class='group block py-5 cursor-pointer'
              >
                <span class='font-serif text-ink font-medium text-[clamp(32px,7.5vw,44px)] leading-[1.1] tracking-tight transition-colors duration-300 group-hover:text-accent'>
                  {tail ? (
                    <>
                      {head}{' '}
                      <em class='italic text-accent font-normal transition-colors duration-300 group-hover:text-accent-hover'>
                        {tail}
                      </em>
                    </>
                  ) : (
                    link.label
                  )}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- CTA outline navy, texto+flecha centrados juntos -->
  {bookingAction && (
    <div class='pt-8'>
      <a
        href={bookingAction.href}
        target={bookingAction.external ? '_blank' : undefined}
        rel={bookingAction.external ? 'noopener' : undefined}
        class='group flex items-center justify-center gap-3 py-4 px-6 bg-transparent text-accent border border-accent rounded-md font-sans font-semibold uppercase text-[12px] tracking-[0.28em] cursor-pointer transition-[background-color,color] duration-300 hover:bg-accent hover:text-bg'
      >
        <span>{bookingAction.label ?? reservarLabel}</span>
        <span aria-hidden='true' class='transition-transform duration-300 group-hover:translate-x-1'>→</span>
      </a>
    </div>
  )}

  <!-- Footer: contacto centrado + idiomas discretos -->
  <div class='flex flex-col items-center gap-5 pt-8 mt-6 border-t border-line-strong/25 text-center'>
    <div class='flex flex-col gap-2'>
      {
        bookingPhone && (
          <a
            href={`tel:${bookingPhone}`}
            class='font-serif text-ink text-[16px] leading-[1.4] transition-colors duration-300 hover:text-accent cursor-pointer'
          >
            {bookingPhone}
          </a>
        )
      }
      {
        waHref && (
          <a
            href={waHref}
            target='_blank'
            rel='noopener'
            class='font-serif text-ink text-[16px] leading-[1.4] transition-colors duration-300 hover:text-accent cursor-pointer'
          >
            WhatsApp <span class='text-dim mx-1'>·</span> {whatsappRaw}
          </a>
        )
      }
      {
        bookingEmail && (
          <a
            href={`mailto:${bookingEmail}`}
            class='font-serif text-ink text-[16px] leading-[1.4] transition-colors duration-300 hover:text-accent cursor-pointer'
          >
            {bookingEmail}
          </a>
        )
      }
    </div>

    {
      localesUi.length > 1 && (
        <div
          aria-label={a11y.language}
          class='flex items-center gap-3 font-sans font-semibold uppercase text-[10.5px] tracking-[0.3em] pt-2'
        >
          {localesUi.map((l, i) => (
            <>
              {i > 0 && <span class='text-line-strong opacity-70 select-none'>·</span>}
              <a
                href={
                  l.codigo === locale
                    ? '#'
                    : localizedPath(langSwitcherPath, l.codigo, defaultLocale)
                }
                class:list={[
                  'py-1 transition-colors duration-300',
                  l.codigo === locale
                    ? 'text-accent border-b border-accent pointer-events-none'
                    : 'text-muted hover:text-ink cursor-pointer'
                ]}
                aria-current={l.codigo === locale ? 'true' : undefined}
              >
                {l.codigo.toUpperCase()}
              </a>
            </>
          ))}
        </div>
      )
    }
  </div>
</div>

<script is:inline>
  (function () {
    const hamburger = document.getElementById('hamburgerBtn');
    const closeBtn = document.getElementById('mobileCloseBtn');
    const overlay = document.getElementById('mobileOverlay');
    if (!hamburger || !overlay) return;

    const setOpen = open => {
      overlay.dataset.open = open ? 'true' : 'false';
      document.body.classList.toggle('overlay-open', open);
      hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
      overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (open) closeBtn?.focus();
      else hamburger?.focus();
    };

    hamburger.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && overlay.dataset.open === 'true') setOpen(false);
    });

    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.onclick = e => {
        const target = a.getAttribute('href');
        if (target === '#') return;
        const el = document.querySelector(target);
        if (!el) return;
        e.preventDefault();
        const wasOpen = overlay.dataset.open === 'true';
        if (wasOpen) setOpen(false);
        setTimeout(
          () => el.scrollIntoView({ behavior: 'smooth', block: 'start' }),
          wasOpen ? 240 : 0
        );
      };
    });
  })();
</script>
