---
interface Props {
  size?: number;
  class?: string;
  ariaHidden?: boolean;
}
const { size = 14, class: cls = '', ariaHidden = true } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden={ariaHidden}
  class={cls}
>
  <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
