---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant } from '../lib/queries';
import { splitLastWord } from '../lib/typography';
import { buildHoursByDay } from '../lib/schedule';
import Tag from '../components/Tag.astro';
import CtaButton from '../components/CtaButton.astro';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
  bookingEmail: string;
}

const { restaurant, locale, defaultLocale, bookingEmail } = Astro.props;

const nav = restaurant.textosNav ?? {};
const form = restaurant.textosForm ?? {};
const title = t(form.titulo, locale, defaultLocale);
const { head, tail } = splitLastWord(title);

// Horas por día en decimal (0=Dom, 1=Lun...6=Sáb) → para date/time pickers
const hoursByDay = buildHoursByDay(restaurant.horariosSemana);

// i18n strings de UI de los pickers (no vienen de Sanity — chrome interno)
const T: Record<
  string,
  {
    pickDate: string;
    pickTime: string;
    prev: string;
    next: string;
    closed: string;
    selectDateFirst: string;
    monthNames: string[];
    dayShort: string[];
    errPhone: string;
    errEmail: string;
    errGuests: string;
    errDate: string;
    errTime: string;
  }
> = {
  es: {
    pickDate: 'Elegir fecha',
    pickTime: 'Elegir hora',
    prev: 'Anterior',
    next: 'Siguiente',
    closed: 'Cerrado',
    selectDateFirst: 'Elige primero la fecha',
    monthNames: [
      'Enero','Febrero','Marzo','Abril','Mayo','Junio',
      'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre',
    ],
    dayShort: ['L','M','X','J','V','S','D'],
    errPhone: 'Introduce un número español válido (ej: 612 345 678)',
    errEmail: 'Introduce un email válido',
    errGuests: 'Comensales: entre 1 y 20',
    errDate: 'Elige una fecha',
    errTime: 'Elige una hora',
  },
  en: {
    pickDate: 'Pick a date',
    pickTime: 'Pick a time',
    prev: 'Previous',
    next: 'Next',
    closed: 'Closed',
    selectDateFirst: 'Pick a date first',
    monthNames: [
      'January','February','March','April','May','June',
      'July','August','September','October','November','December',
    ],
    dayShort: ['M','T','W','T','F','S','S'],
    errPhone: 'Enter a valid Spanish number (e.g. 612 345 678)',
    errEmail: 'Enter a valid email',
    errGuests: 'Guests: between 1 and 20',
    errDate: 'Pick a date',
    errTime: 'Pick a time',
  },
  ca: {
    pickDate: 'Escollir data',
    pickTime: 'Escollir hora',
    prev: 'Anterior',
    next: 'Següent',
    closed: 'Tancat',
    selectDateFirst: 'Escull primer la data',
    monthNames: [
      'Gener','Febrer','Març','Abril','Maig','Juny',
      'Juliol','Agost','Setembre','Octubre','Novembre','Desembre',
    ],
    dayShort: ['Dl','Dm','Dc','Dj','Dv','Ds','Dg'],
    errPhone: 'Introdueix un número espanyol vàlid (ex: 612 345 678)',
    errEmail: 'Introdueix un email vàlid',
    errGuests: 'Comensals: entre 1 i 20',
    errDate: 'Escull una data',
    errTime: 'Escull una hora',
  },
};
const tt = T[locale] ?? T.es;

// Clases compartidas para inputs — inputs con look serif Bodoni (Guixot brasserie)
const inputCls =
  'w-full bg-transparent border-0 border-b border-line-strong py-3 pb-3.5 px-0 font-serif text-ink text-[17px] font-normal transition-colors duration-300 focus:outline-none focus:border-accent placeholder:text-dim placeholder:italic';
const labelCls =
  'flex flex-col gap-2 font-sans uppercase text-muted font-medium text-[11px] tracking-[0.22em]';
const errorCls =
  'text-[11px] tracking-normal normal-case text-accent-alt italic hidden data-[error]:block';

// Botón "picker" (calendario / hora) — mismo look que inputs pero clickeable
const pickerBtnCls =
  'w-full bg-transparent border-0 border-b border-line-strong py-3 pb-3.5 px-0 font-serif text-ink text-[17px] font-normal text-left transition-colors duration-300 hover:border-accent focus:outline-none focus:border-accent flex items-center justify-between gap-3 cursor-pointer';
---

<section id="book" class="py-[14vh] px-(--gap) max-w-[820px] mx-auto max-[900px]:py-[10vh]">
  <div class="reveal text-center mb-14">
    <Tag class="mb-6 mx-auto">{t(nav.linkReservar, locale, defaultLocale) || 'Reserva'}</Tag>
    <h2 class="font-serif font-medium leading-[1.05] tracking-[-0.01em] text-[clamp(38px,5vw,68px)] mb-5">
      {tail ? (
        <>
          {head} <em class="italic text-accent font-normal">{tail}</em>
        </>
      ) : (
        title
      )}
    </h2>
    <p class="text-muted text-[16px] leading-[1.7] mx-auto max-w-[52ch]">
      {t(form.intro, locale, defaultLocale)}
    </p>
  </div>

  <form
    id="reservaForm"
    novalidate
    class="reveal grid grid-cols-2 gap-y-8 gap-x-8 max-[700px]:grid-cols-1 max-[700px]:gap-6"
  >
    <!-- Nombre -->
    <label class={labelCls}>
      <span>{t(form.labelNombre, locale, defaultLocale) || 'Nombre'}</span>
      <input type="text" name="nombre" required autocomplete="name" class={inputCls} />
    </label>

    <!-- Teléfono (solo dígitos + prefijo, validación española) -->
    <label class={labelCls}>
      <span>{t(form.labelTelefono, locale, defaultLocale) || 'Teléfono'}</span>
      <input
        type="tel"
        name="telefono"
        required
        autocomplete="tel"
        inputmode="tel"
        placeholder="612 345 678"
        maxlength="17"
        class={inputCls}
        data-input-phone
      />
      <span class={errorCls} data-error-for="telefono"></span>
    </label>

    <!-- Email -->
    <label class={labelCls}>
      <span>{t(form.labelEmail, locale, defaultLocale) || 'Email'}</span>
      <input
        type="email"
        name="email"
        autocomplete="email"
        placeholder="hola@ejemplo.com"
        class={inputCls}
        data-input-email
      />
      <span class={errorCls} data-error-for="email"></span>
    </label>

    <!-- Comensales (input text con filtro numérico, sin spinner ugly) -->
    <label class={labelCls}>
      <span>{t(form.labelComensales, locale, defaultLocale) || 'Comensales'}</span>
      <input
        type="text"
        name="personas"
        required
        inputmode="numeric"
        pattern="[0-9]{1,2}"
        maxlength="2"
        value="2"
        placeholder="2"
        class={inputCls}
        data-input-guests
      />
      <span class={errorCls} data-error-for="personas"></span>
    </label>

    <!-- Fecha custom picker -->
    <label class={labelCls}>
      <span>{t(form.labelFecha, locale, defaultLocale) || 'Fecha'}</span>
      <div class="relative">
        <button type="button" class={pickerBtnCls} data-datepicker-btn>
          <span data-datepicker-label class="text-dim italic">{tt.pickDate}</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="text-muted shrink-0">
            <rect x="3" y="4" width="14" height="13" rx="1" stroke="currentColor" stroke-width="1.4" />
            <path d="M3 8h14M7 2v4M13 2v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </button>
        <input type="hidden" name="fecha" required data-datepicker-input />
        <!-- Popover: se renderiza vía JS al abrir -->
        <div
          data-datepicker-pop
          class="hidden absolute z-50 left-0 top-[calc(100%+8px)] w-[300px] bg-bg border border-line-strong rounded-sm shadow-[0_20px_50px_-15px_rgb(30_58_95/0.35)] p-4 max-[700px]:w-full max-[700px]:max-w-[320px]"
        ></div>
      </div>
      <span class={errorCls} data-error-for="fecha"></span>
    </label>

    <!-- Hora custom picker -->
    <label class={labelCls}>
      <span>{t(form.labelHora, locale, defaultLocale) || 'Hora'}</span>
      <div class="relative">
        <button type="button" class={pickerBtnCls} data-timepicker-btn>
          <span data-timepicker-label class="text-dim italic">{tt.pickTime}</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="text-muted shrink-0">
            <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.4" />
            <path d="M10 6v4l2.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </button>
        <input type="hidden" name="hora" required data-timepicker-input />
        <div
          data-timepicker-pop
          class="hidden absolute z-50 left-0 top-[calc(100%+8px)] w-[320px] bg-bg border border-line-strong rounded-sm shadow-[0_20px_50px_-15px_rgb(30_58_95/0.35)] p-4 max-[700px]:w-full max-[700px]:max-w-[340px]"
        ></div>
      </div>
      <span class={errorCls} data-error-for="hora"></span>
    </label>

    <!-- Notas -->
    <label class:list={[labelCls, 'col-span-full']}>
      <span>{t(form.labelNotas, locale, defaultLocale) || 'Notas'}</span>
      <textarea
        name="notas"
        rows="3"
        class:list={[inputCls, 'resize-y min-h-[90px] leading-normal']}
      ></textarea>
    </label>

    <CtaButton type="submit" class="col-span-full justify-self-center mt-4">
      {t(form.submit, locale, defaultLocale) || 'Enviar'}
    </CtaButton>
    <p
      id="reservaMsg"
      role="status"
      aria-live="polite"
      class="col-span-full text-center min-h-[1.4em] text-[13px] tracking-[0.04em] text-muted italic"
    ></p>
  </form>
</section>

<script is:inline define:vars={{ hoursByDay, tt, bookingEmail, restaurantName: restaurant.nombre }}>
(function () {
  const form = document.getElementById('reservaForm');
  if (!form) return;
  const msgEl = document.getElementById('reservaMsg');

  // ═══════════════════════════════════════════════════════════════════════
  // Helpers de validación + UI de error
  // ═══════════════════════════════════════════════════════════════════════
  const showError = (name, msg) => {
    const errEl = form.querySelector(`[data-error-for="${name}"]`);
    if (!errEl) return;
    if (msg) {
      errEl.textContent = msg;
      errEl.setAttribute('data-error', '');
    } else {
      errEl.textContent = '';
      errEl.removeAttribute('data-error');
    }
  };

  const validSpanishPhone = (raw) => {
    const cleaned = (raw || '').replace(/\s/g, '');
    // +34 opcional, luego 9 dígitos empezando por 6/7 (móvil) o 8/9 (fijo)
    return /^(\+34)?[6789]\d{8}$/.test(cleaned);
  };

  const validEmail = (raw) => {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((raw || '').trim());
  };

  const validGuests = (raw) => {
    const n = parseInt(raw, 10);
    return Number.isFinite(n) && n >= 1 && n <= 20;
  };

  // ═══════════════════════════════════════════════════════════════════════
  // Phone: filtro caracteres + validación en blur
  // ═══════════════════════════════════════════════════════════════════════
  const phoneEl = form.querySelector('[data-input-phone]');
  if (phoneEl) {
    phoneEl.addEventListener('input', (e) => {
      // Permitir solo dígitos, espacios y + (para prefijo internacional)
      let v = e.target.value.replace(/[^\d+ ]/g, '');
      // + solo al inicio
      v = v.replace(/(?!^)\+/g, '');
      e.target.value = v;
      if (validSpanishPhone(v)) showError('telefono', '');
    });
    phoneEl.addEventListener('blur', () => {
      const v = phoneEl.value.trim();
      if (v && !validSpanishPhone(v)) showError('telefono', tt.errPhone);
      else showError('telefono', '');
    });
  }

  // ═══════════════════════════════════════════════════════════════════════
  // Email: validación en blur
  // ═══════════════════════════════════════════════════════════════════════
  const emailEl = form.querySelector('[data-input-email]');
  if (emailEl) {
    emailEl.addEventListener('blur', () => {
      const v = emailEl.value.trim();
      if (v && !validEmail(v)) showError('email', tt.errEmail);
      else showError('email', '');
    });
    emailEl.addEventListener('input', () => {
      if (validEmail(emailEl.value)) showError('email', '');
    });
  }

  // ═══════════════════════════════════════════════════════════════════════
  // Guests (comensales): filtro solo dígitos + clamp 1-20
  // ═══════════════════════════════════════════════════════════════════════
  const guestsEl = form.querySelector('[data-input-guests]');
  if (guestsEl) {
    guestsEl.addEventListener('input', (e) => {
      let v = e.target.value.replace(/\D/g, '');
      if (v.length > 2) v = v.slice(0, 2);
      const n = parseInt(v, 10);
      if (n > 20) v = '20';
      e.target.value = v;
      if (validGuests(v)) showError('personas', '');
    });
    guestsEl.addEventListener('blur', () => {
      if (guestsEl.value && !validGuests(guestsEl.value)) showError('personas', tt.errGuests);
      else showError('personas', '');
    });
  }

  // ═══════════════════════════════════════════════════════════════════════
  // Popover manager: cierra al click fuera + escape
  // ═══════════════════════════════════════════════════════════════════════
  const closeAllPopovers = () => {
    document.querySelectorAll('[data-datepicker-pop], [data-timepicker-pop]').forEach((p) => {
      p.classList.add('hidden');
    });
  };
  document.addEventListener('click', (e) => {
    if (!e.target.closest('[data-datepicker-btn], [data-datepicker-pop], [data-timepicker-btn], [data-timepicker-pop]')) {
      closeAllPopovers();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPopovers();
  });

  // ═══════════════════════════════════════════════════════════════════════
  // Date picker custom
  // ═══════════════════════════════════════════════════════════════════════
  const dateBtn = form.querySelector('[data-datepicker-btn]');
  const dateLabel = form.querySelector('[data-datepicker-label]');
  const dateInput = form.querySelector('[data-datepicker-input]');
  const datePop = form.querySelector('[data-datepicker-pop]');

  let dpMonth = new Date().getMonth();
  let dpYear = new Date().getFullYear();
  let dpSelected = null; // ISO string YYYY-MM-DD

  const isoDate = (d) => {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  };
  const parseISO = (iso) => {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d);
  };
  const formatHumanDate = (iso) => {
    const d = parseISO(iso);
    const weekday = tt.dayShort[(d.getDay() + 6) % 7]; // shift Sun to end
    return `${weekday} ${d.getDate()} ${tt.monthNames[d.getMonth()].toLowerCase()} ${d.getFullYear()}`;
  };

  const renderCalendar = () => {
    if (!datePop) return;
    const first = new Date(dpYear, dpMonth, 1);
    const daysInMonth = new Date(dpYear, dpMonth + 1, 0).getDate();
    // Convertir getDay (0=Sun) a offset semana Lun-Dom
    const startOffset = (first.getDay() + 6) % 7;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Cabecera semana (Lun a Dom)
    const weekHead = tt.dayShort
      .map((d) => `<div class="text-center text-[10px] font-semibold uppercase tracking-[0.14em] text-dim py-1.5">${d}</div>`)
      .join('');

    // Días vacíos al inicio + días del mes
    let cells = '';
    for (let i = 0; i < startOffset; i++) cells += '<div></div>';
    for (let d = 1; d <= daysInMonth; d++) {
      const cellDate = new Date(dpYear, dpMonth, d);
      const iso = isoDate(cellDate);
      const dayOfWeek = cellDate.getDay(); // 0=Sun..6=Sat
      const isPast = cellDate < today;
      const isClosed = !hoursByDay[dayOfWeek] || hoursByDay[dayOfWeek].length === 0;
      const isDisabled = isPast || isClosed;
      const isSelected = dpSelected === iso;
      const isToday = iso === isoDate(today);

      const classes = [
        'w-9 h-9 flex items-center justify-center text-[13px] font-sans tabular-nums rounded-sm transition-colors',
        isDisabled
          ? 'text-dim/50 cursor-not-allowed line-through decoration-line/60'
          : 'text-ink hover:bg-accent hover:text-bg cursor-pointer',
        isSelected && !isDisabled ? 'bg-accent text-bg font-semibold' : '',
        isToday && !isSelected ? 'ring-1 ring-accent/60' : '',
      ].filter(Boolean).join(' ');

      cells += `<button type="button" class="${classes}" ${isDisabled ? 'disabled' : `data-day="${iso}"`}>${d}</button>`;
    }

    datePop.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <button type="button" data-dp-prev aria-label="${tt.prev}" class="w-7 h-7 flex items-center justify-center rounded-sm text-muted hover:text-accent hover:bg-line/40 cursor-pointer transition-colors">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M12 15l-5-5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="font-serif text-[15px] font-medium tracking-tight text-ink">${tt.monthNames[dpMonth]} ${dpYear}</div>
        <button type="button" data-dp-next aria-label="${tt.next}" class="w-7 h-7 flex items-center justify-center rounded-sm text-muted hover:text-accent hover:bg-line/40 cursor-pointer transition-colors">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M8 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-7 gap-1 mb-1">${weekHead}</div>
      <div class="grid grid-cols-7 gap-1">${cells}</div>
    `;

    // Bind navegación de mes
    datePop.querySelector('[data-dp-prev]')?.addEventListener('click', () => {
      dpMonth--;
      if (dpMonth < 0) { dpMonth = 11; dpYear--; }
      renderCalendar();
    });
    datePop.querySelector('[data-dp-next]')?.addEventListener('click', () => {
      dpMonth++;
      if (dpMonth > 11) { dpMonth = 0; dpYear++; }
      renderCalendar();
    });
    // Bind selección de día
    datePop.querySelectorAll('[data-day]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const iso = btn.getAttribute('data-day');
        dpSelected = iso;
        dateInput.value = iso;
        dateLabel.textContent = formatHumanDate(iso);
        dateLabel.classList.remove('text-dim', 'italic');
        dateLabel.classList.add('text-ink');
        showError('fecha', '');
        // Reset hora al cambiar fecha (los turnos del nuevo día pueden ser distintos)
        tpSelected = null;
        timeInput.value = '';
        timeLabel.textContent = tt.pickTime;
        timeLabel.classList.add('text-dim', 'italic');
        timeLabel.classList.remove('text-ink');
        datePop.classList.add('hidden');
      });
    });
  };

  dateBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !datePop.classList.contains('hidden');
    closeAllPopovers();
    if (!isOpen) {
      renderCalendar();
      datePop.classList.remove('hidden');
    }
  });

  // ═══════════════════════════════════════════════════════════════════════
  // Time picker custom (slots derivados de horariosSemana + fecha seleccionada)
  // ═══════════════════════════════════════════════════════════════════════
  const timeBtn = form.querySelector('[data-timepicker-btn]');
  const timeLabel = form.querySelector('[data-timepicker-label]');
  const timeInput = form.querySelector('[data-timepicker-input]');
  const timePop = form.querySelector('[data-timepicker-pop]');
  let tpSelected = null;

  const decimalToHHMM = (dec) => {
    const h = Math.floor(dec);
    const m = Math.round((dec - h) * 60);
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
  };

  const renderTimeSlots = () => {
    if (!timePop) return;
    if (!dpSelected) {
      timePop.innerHTML = `<div class="text-center text-muted italic text-[13px] py-6">${tt.selectDateFirst}</div>`;
      return;
    }
    const d = parseISO(dpSelected);
    const dayOfWeek = d.getDay();
    const turnos = hoursByDay[dayOfWeek] || [];
    if (!turnos.length) {
      timePop.innerHTML = `<div class="text-center text-muted italic text-[13px] py-6">${tt.closed}</div>`;
      return;
    }

    // Genera slots cada 15 min por turno, dejando 30 min de margen al cierre
    // (última reserva 30 min antes de cerrar para dar tiempo al cliente).
    const html = turnos.map(([open, close]) => {
      const slots = [];
      for (let h = open; h + 0.5 <= close; h += 0.25) {
        slots.push(decimalToHHMM(h));
      }
      const buttons = slots.map((s) => {
        const isSel = tpSelected === s;
        const cls = [
          'py-2 px-2 text-[13px] font-sans tabular-nums rounded-sm border transition-colors',
          isSel
            ? 'bg-accent text-bg border-accent font-semibold'
            : 'text-ink border-line hover:border-accent hover:bg-accent hover:text-bg cursor-pointer',
        ].join(' ');
        return `<button type="button" class="${cls}" data-slot="${s}">${s}</button>`;
      }).join('');
      const rangeLabel = `${decimalToHHMM(open)}–${decimalToHHMM(close)}`;
      return `
        <div class="mb-3 last:mb-0">
          <div class="text-[10px] uppercase tracking-[0.18em] text-dim font-semibold mb-2">${rangeLabel}</div>
          <div class="grid grid-cols-4 gap-1.5">${buttons}</div>
        </div>
      `;
    }).join('');

    timePop.innerHTML = html;

    timePop.querySelectorAll('[data-slot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const s = btn.getAttribute('data-slot');
        tpSelected = s;
        timeInput.value = s;
        timeLabel.textContent = s;
        timeLabel.classList.remove('text-dim', 'italic');
        timeLabel.classList.add('text-ink');
        showError('hora', '');
        timePop.classList.add('hidden');
      });
    });
  };

  timeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !timePop.classList.contains('hidden');
    closeAllPopovers();
    if (!isOpen) {
      renderTimeSlots();
      timePop.classList.remove('hidden');
    }
  });

  // ═══════════════════════════════════════════════════════════════════════
  // Submit
  // ═══════════════════════════════════════════════════════════════════════
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;

    // Nombre required (HTML5 basic)
    const nameEl = form.querySelector('input[name="nombre"]');
    if (!nameEl.value.trim()) ok = false;

    // Phone
    if (!validSpanishPhone(phoneEl.value)) {
      showError('telefono', tt.errPhone);
      ok = false;
    }
    // Email (opcional pero si hay, válido)
    if (emailEl.value.trim() && !validEmail(emailEl.value)) {
      showError('email', tt.errEmail);
      ok = false;
    }
    // Guests
    if (!validGuests(guestsEl.value)) {
      showError('personas', tt.errGuests);
      ok = false;
    }
    // Date + Time
    if (!dateInput.value) { showError('fecha', tt.errDate); ok = false; }
    if (!timeInput.value) { showError('hora', tt.errTime); ok = false; }

    if (!ok) return;

    const d = new FormData(form);
    const nombre = d.get('nombre'),
      telefono = d.get('telefono'),
      email = d.get('email') || '(no indicado)',
      personas = d.get('personas'),
      fecha = d.get('fecha'),
      hora = d.get('hora'),
      notas = d.get('notas') || '(sin notas)';
    const subject = `Reserva: ${nombre} — ${personas} pax — ${fecha} ${hora}`;
    const body =
`Solicitud de reserva en ${restaurantName}

Nombre: ${nombre}
Teléfono: ${telefono}
Email: ${email}
Comensales: ${personas}
Fecha: ${fecha}
Hora: ${hora}
Notas: ${notas}`;
    window.location.href =
      'mailto:' + bookingEmail + '?subject=' +
      encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    if (msgEl) msgEl.textContent = '…';
  });
})();
</script>
