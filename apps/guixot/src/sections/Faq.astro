---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant } from '../lib/queries';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
}

const { restaurant, locale, defaultLocale } = Astro.props;

if (!restaurant.faq?.length) return null;

// Rótulos fijos por idioma: no vienen de Sanity.
const T: Record<string, { eyebrow: string; title: string }> = {
  es: { eyebrow: 'Preguntas frecuentes', title: 'Todo lo que necesitas saber' },
  en: { eyebrow: 'Frequently asked', title: 'Everything you need to know' },
  ca: { eyebrow: 'Preguntes freqüents', title: 'Tot el que necessites saber' }
};
const tt = T[locale] ?? T.es;
---

<section id='faq' class='section-y px-(--gap)'>
  <div class='mx-auto max-w-[900px]'>
    <SectionHeading eyebrow={tt.eyebrow} title={tt.title} class='mb-14 max-[700px]:mb-10' />

    <div class='stagger border-t border-line-strong/70'>
      {restaurant.faq.map((item, i) => (
        <details class='reveal faq-item group border-b border-line'>
          <summary
            class='grid items-center grid-cols-[44px_1fr_auto] gap-5 py-5.5 cursor-pointer list-none
                   [&::-webkit-details-marker]:hidden transition-colors duration-200 hover:text-accent
                   max-[700px]:grid-cols-[32px_1fr_auto] max-[700px]:gap-3.5'
          >
            <span aria-hidden='true' class='font-serif italic font-medium text-accent-alt leading-none text-[22px] max-[700px]:text-[18px]'>
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class='font-serif font-medium leading-[1.35] text-[clamp(18px,1.8vw,22px)] transition-colors duration-200 group-open:text-accent'>
              {t(item.pregunta, locale, defaultLocale)}
            </span>
            <span
              class='flex items-center justify-center w-9 h-9 rounded-full border border-line-strong text-ink shrink-0
                     transition-[transform,background-color,color,border-color] duration-300 ease-[cubic-bezier(.65,0,.35,1)]
                     group-open:rotate-45 group-open:bg-accent group-open:border-accent group-open:text-bg motion-reduce:transition-none'
            >
              <Icon name='plus' size={16} />
            </span>
          </summary>
          <div
            class='faq-body overflow-hidden opacity-0 h-0
                   transition-[height,opacity] duration-[360ms] ease-[cubic-bezier(.65,0,.35,1)]
                   group-open:opacity-100 group-open:h-auto motion-reduce:transition-none'
          >
            <p class='text-ink-soft text-[16px] leading-[1.75] max-w-[62ch] pl-16 pr-14 pb-6 max-[700px]:pl-[46px] max-[700px]:pr-2'>
              {t(item.respuesta, locale, defaultLocale)}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // Acordeón: solo una pregunta abierta a la vez; al abrir otra, la anterior se cierra.
  (function () {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = Array.from(document.querySelectorAll('details.faq-item'));

    // Si la transición no llega a arrancar, `transitionend` no se dispara: el
    // temporizador garantiza que la pregunta nunca se quede bloqueada a medias.
    function onHeightEnd(body, done) {
      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;
        clearTimeout(timer);
        body.removeEventListener('transitionend', onEnd);
        done();
      };
      const onEnd = (ev) => { if (ev.propertyName === 'height') finish(); };
      const timer = setTimeout(finish, 480);
      body.addEventListener('transitionend', onEnd);
    }

    function close(details) {
      const body = details.querySelector('.faq-body');
      if (!details.hasAttribute('open')) return;
      // Aún se está abriendo: se cerrará en cuanto termine.
      if (details.dataset.animating) { details.dataset.closeAfter = '1'; return; }
      details.dataset.animating = '1';
      body.style.height = body.scrollHeight + 'px';
      void body.offsetHeight; // fija la altura de partida antes de animar
      body.style.height = '0px';
      onHeightEnd(body, () => {
        details.removeAttribute('open');
        body.style.height = '';
        delete details.dataset.animating;
      });
    }

    function open(details) {
      const body = details.querySelector('.faq-body');
      if (details.dataset.animating) return;
      details.dataset.animating = '1';
      delete details.dataset.closeAfter;
      details.setAttribute('open', '');
      body.style.height = '0px';
      void body.offsetHeight;
      body.style.height = body.scrollHeight + 'px';
      onHeightEnd(body, () => {
        body.style.height = 'auto';
        delete details.dataset.animating;
        if (details.dataset.closeAfter) { delete details.dataset.closeAfter; close(details); }
      });
    }

    items.forEach((details) => {
      const summary = details.querySelector('summary');
      if (!summary || !details.querySelector('.faq-body')) return;

      if (reduce) {
        // Sin animación: el navegador abre y cierra; aquí solo se cierran las demás.
        details.addEventListener('toggle', () => {
          if (details.open) items.forEach((other) => { if (other !== details) other.open = false; });
        });
        return;
      }

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        if (details.dataset.animating) return;
        if (details.hasAttribute('open')) return close(details);
        items.forEach((other) => { if (other !== details) close(other); });
        open(details);
      });
    });
  })();
</script>
