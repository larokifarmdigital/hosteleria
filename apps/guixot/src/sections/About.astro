---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/content';
import type { Restaurant } from '../lib/queries';
import { extractI18nParagraphs } from '@hosteleria/utils';
import SectionHeading from '../components/SectionHeading.astro';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
}

const { restaurant, locale, defaultLocale } = Astro.props;

// Hasta 3 imágenes (el schema limita a 3). Placeholder local si no hay ninguna.
const imagesInput = (restaurant.sobreImagenes ?? [])
  .slice(0, 3)
  .map(i => img.url(i))
  .filter((u): u is string => Boolean(u));
const images = imagesInput.length > 0 ? imagesInput : ['/img/gal-room.jpg'];

const eyebrow = t(restaurant.sobreEyebrow, locale, defaultLocale);
const title = t(restaurant.sobreTitulo, locale, defaultLocale);
const paragraphs = extractI18nParagraphs(restaurant.sobreCuerpo, locale, defaultLocale);
---

<!--
  About de Guixot: apilado. Cabecera centrada, texto en columna estrecha con
  capitular navy y fila de fotos debajo (1, 2 o 3).
-->
<section id='about' class='section-y px-(--gap)'>
  <div class='mx-auto max-w-[var(--max)]'>
    <SectionHeading eyebrow={eyebrow} title={title} split='half' class='mb-[clamp(40px,7vh,72px)]' />

    {paragraphs.length > 0 && (
      <div class='stagger mx-auto max-w-[680px]'>
        {paragraphs.map((p, i) => (
          <p class:list={['reveal leading-[1.8]', i === 0 ? 'text-ink text-[18px]' : 'text-ink-soft text-[17px] mt-6']}>
            {i === 0 ? (
              <>
                {/* La capitular es decorativa: el lector de pantalla lee la palabra entera. */}
                <span aria-hidden='true' class='float-left font-serif font-medium text-accent leading-[0.85] text-[76px] mr-3 mt-1.5 max-[700px]:text-[62px]'>{p.charAt(0)}</span>
                <span class='sr-only'>{p.charAt(0)}</span>{p.slice(1)}
              </>
            ) : p}
          </p>
        ))}
      </div>
    )}

    <div
      class:list={[
        'stagger mx-auto mt-[clamp(48px,9vh,88px)] grid gap-[clamp(16px,2.6vw,32px)] max-[700px]:grid-cols-1',
        images.length === 1 && 'max-w-[560px] grid-cols-1',
        images.length === 2 && 'max-w-[900px] grid-cols-2',
        images.length === 3 && 'max-w-[1080px] grid-cols-3'
      ]}
    >
      {images.map((src, i) => (
        <figure
          data-reveal='img'
          class:list={[
            'reveal aspect-[4/5] overflow-hidden bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)] max-[700px]:aspect-[4/3]',
            /* Con tres fotos, la del centro baja: rompe la fila sin cambiar la estructura. */
            images.length === 3 && i === 1 && 'min-[701px]:translate-y-8'
          ]}
        >
          <img src={src} alt='' class='w-full h-full object-cover' loading='lazy' decoding='async' />
        </figure>
      ))}
    </div>
  </div>
</section>
