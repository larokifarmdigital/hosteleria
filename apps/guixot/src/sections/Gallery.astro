---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/sanity';
import type { Restaurant } from '../lib/queries';
import { splitLastWord } from '@hosteleria/utils';
import Tag from '../components/Tag.astro';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
}

const { restaurant, locale, defaultLocale } = Astro.props;

const sec = restaurant.textosSecciones ?? {};
const title = t(sec.galeriaTitulo, locale, defaultLocale) || 'El local';
const { head, tail } = splitLastWord(title);

const galeriaFallback = [
  '/img/gal-table.jpg', '/img/gal-room.jpg', '/img/gal-soup.jpg',
  '/img/gal-martini.jpg', '/img/cellar.jpg', '/img/pass.jpg',
  '/img/glass.jpg', '/img/hire.jpg', '/img/kitchen.jpg',
];
const galeriaImgs = restaurant.galeria?.length
  ? restaurant.galeria.map((g) => img.url(g) ?? '/img/gal-room.jpg')
  : galeriaFallback;
---

<!--
  Guixot Gallery: grid asimétrico con posiciones específicas (algunas fotos
  span 2 rows) para look editorial de revista gastronómica.
-->
<section id="gallery" class="py-[12vh] px-(--gap) max-w-[var(--max)] mx-auto max-[900px]:py-[8vh]">
  <div class="reveal text-center mb-14 max-[900px]:mb-10">
    <Tag class="mb-6 mx-auto">{t(sec.galeriaEyebrow, locale, defaultLocale)}</Tag>
    <h2 class="font-serif font-medium leading-none tracking-[-0.01em] text-[clamp(38px,5vw,64px)]">
      {tail ? (
        <>
          {head} <em class="italic text-accent font-normal">{tail}</em>
        </>
      ) : (
        title
      )}
    </h2>
  </div>

  <div
    class="grid grid-cols-4 gap-3 auto-rows-[180px] max-[900px]:grid-cols-2 max-[900px]:auto-rows-[160px] max-[600px]:grid-cols-1 max-[600px]:auto-rows-[240px]"
  >
    {galeriaImgs.map((src, i) => (
      <!-- posiciones específicas: 1er y 5to span 2 rows + 2 cols para asymmetria editorial -->
      <div
        data-gallery-item
        class:list={[
          'group relative overflow-hidden bg-surface cursor-zoom-in',
          'shadow-[0_12px_30px_-8px_rgb(30_58_95/0.2)]',
          'transition-[box-shadow,transform] duration-[400ms] ease-out',
          'hover:shadow-[0_20px_50px_-10px_rgb(30_58_95/0.35)] hover:-translate-y-1',
          i === 0 && 'col-span-2 row-span-2 max-[900px]:col-span-2 max-[900px]:row-span-1 max-[600px]:col-span-1',
          i === 4 && 'row-span-2 max-[900px]:row-span-1',
          'max-[900px]:hover:translate-y-0',
        ]}
      >
        <img
          src={src}
          alt=""
          loading="lazy"
          class="w-full h-full object-cover brightness-[0.95] saturate-[0.92] transition-[transform,filter] duration-[1100ms] ease-[cubic-bezier(.2,.6,.2,1)] group-hover:scale-[1.06] group-hover:brightness-100 group-hover:saturate-100"
        />
      </div>
    ))}
  </div>
</section>

<div
  id="lightbox"
  data-open="false"
  class="fixed inset-0 z-[200] grid place-items-center cursor-zoom-out invisible opacity-0 bg-[rgb(26_29_36/0.94)] transition-[opacity,visibility] duration-[400ms] delay-[400ms] data-[open='true']:visible data-[open='true']:opacity-100 data-[open='true']:delay-0"
>
  <img src="" alt="" class="w-auto max-w-[88vw] h-auto max-h-[86vh] object-contain" />
</div>

<script is:inline>
  (function () {
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const lbi = lb.querySelector('img');
    const setOpen = (open) => { lb.dataset.open = open ? 'true' : 'false'; };
    document.querySelectorAll('[data-gallery-item]').forEach((c) => {
      const inner = c.querySelector('img');
      if (!inner) return;
      c.addEventListener('click', () => {
        lbi.src = inner.src;
        setOpen(true);
      });
    });
    lb.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
