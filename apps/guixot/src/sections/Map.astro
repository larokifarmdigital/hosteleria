---
import type { Restaurant } from '../lib/queries';
import {
  extractMapSrc,
  withMapLocale,
  extractCoords,
  extractFTID,
  ftidToCID,
  buildMapsExternalUrl,
} from '@hosteleria/utils';
import Tag from '../components/Tag.astro';

interface Props {
  restaurant: Restaurant;
  locale: string;
}

const { restaurant, locale } = Astro.props;

const rawMapSrc = extractMapSrc(restaurant.mapaUrl);
if (!rawMapSrc) return null;

const mapSrc = withMapLocale(rawMapSrc, locale);
const dir = restaurant.direccion ?? {};

const coords = extractCoords(rawMapSrc);
const ftid = extractFTID(rawMapSrc);
const cid = ftidToCID(ftid);
const fullAddress = [dir.calle, dir.codigoPostal, dir.ciudad, dir.pais]
  .filter(Boolean)
  .join(', ');
const mapsExternalUrl = buildMapsExternalUrl(cid, coords, fullAddress, locale);
---

<section id="map" class="py-[12vh] px-(--gap) bg-bg-2 border-y border-line max-[900px]:py-[10vh]">
  <div class="reveal max-w-[var(--max)] mx-auto mb-14 text-center max-[900px]:mb-10">
    <Tag class="mb-6 mx-auto">{locale === 'en' ? 'How to find us' : 'Cómo llegar'}</Tag>
    <h2 class="font-serif font-medium leading-none tracking-[-0.01em] text-[clamp(36px,4.6vw,60px)]">
      {restaurant.nombre},
      <em class="italic text-accent font-normal">{dir.barrio || dir.ciudad || ''}</em>
    </h2>
  </div>

  <div class="reveal overflow-hidden bg-surface mx-auto max-w-[var(--max)] border border-line-strong shadow-[0_20px_60px_-20px_rgb(30_58_95/0.2)]">
    <iframe
      src={mapSrc}
      title={`${restaurant.nombre} — ${locale === 'en' ? 'How to find us' : 'Cómo llegar'}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      class="block w-full border-0 h-[clamp(340px,52vh,500px)] max-[900px]:h-[clamp(280px,44vh,380px)] filter [filter:grayscale(0.2)_contrast(0.95)_brightness(0.98)]"
    ></iframe>
  </div>

  {mapsExternalUrl && (
    <div class="reveal max-w-[var(--max)] mx-auto mt-8 text-center">
      <a
        href={mapsExternalUrl}
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-2.5 font-sans font-medium uppercase text-accent text-[12px] tracking-[0.22em] py-1 border-b border-accent cursor-pointer transition-colors duration-300 hover:text-accent-hover hover:border-accent-hover"
      >
        {locale === 'en' ? 'Open in Google Maps' : 'Ver en Google Maps'}
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  )}
</section>
