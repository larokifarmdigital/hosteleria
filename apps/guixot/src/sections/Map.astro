---
import type { Restaurant } from '../lib/queries';
import type { HoursUi } from '../lib/hours';
import { getLocation, telHref } from '../lib/location';
import SectionHeading from '../components/SectionHeading.astro';
import HoursList from '../components/HoursList.astro';
import CtaButton from '../components/CtaButton.astro';

interface Props {
  restaurant: Restaurant;
  hours: HoursUi;
  locale: string;
}

const { restaurant, hours, locale } = Astro.props;

const { dir, mapSrc, mapsUrl, area } = getLocation(restaurant, locale);
const phone = restaurant.contacto?.telefono ?? '';

if (!mapSrc && !hours.hasHours && !dir.calle) return null;

const T = {
  es: { eyebrow: 'Horario y cómo llegar', address: 'Dirección', phone: 'Teléfono', directions: 'Cómo llegar', map: 'Mapa' },
  ca: { eyebrow: 'Horari i com arribar', address: 'Adreça', phone: 'Telèfon', directions: 'Com arribar', map: 'Mapa' },
  en: { eyebrow: 'Hours and directions', address: 'Address', phone: 'Phone', directions: 'Get directions', map: 'Map' }
};
const tt = T[locale as keyof typeof T] ?? T.es;
const place = dir.barrio || dir.ciudad || '';
const blockCls = 'py-7 first:pt-0 max-[960px]:py-0';
---

<!--
  Mapa de Guixot: mapa a la izquierda y columna de datos a la derecha, sin
  tarjeta. En tablet la columna pasa a rejilla de dos; en móvil se apila.
-->
<section id='map' class='section-y px-(--gap)'>
  <div class='mx-auto max-w-[var(--max)]'>
    <SectionHeading eyebrow={tt.eyebrow} title={`${restaurant.nombre}${place ? ',' : ''}`} accent={place || undefined} class='mb-14 max-[900px]:mb-10' />

    <div class='grid grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-[clamp(32px,5vw,72px)] items-start max-[960px]:grid-cols-1 max-[960px]:gap-10'>
      {mapSrc && (
        <div class='overflow-hidden bg-surface border border-line-strong rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)]'>
          <iframe
            src={mapSrc}
            title={`${tt.map}: ${restaurant.nombre}${area ? `, ${area}` : ''}`}
            loading='lazy'
            referrerpolicy='no-referrer-when-downgrade'
            allowfullscreen
            data-map-frame
            class='block w-full border-0 rounded-[var(--radius-card)] h-[clamp(460px,64vh,600px)] max-[960px]:h-[clamp(320px,48vh,440px)] [filter:grayscale(0.2)_contrast(0.96)] data-[kbd-focus]:outline-2 data-[kbd-focus]:outline-accent data-[kbd-focus]:-outline-offset-2'
          ></iframe>
        </div>
      )}

      <div class='stagger flex flex-col divide-y divide-line max-[960px]:grid max-[960px]:grid-cols-2 max-[960px]:gap-x-10 max-[960px]:gap-y-9 max-[960px]:divide-y-0 max-[600px]:grid-cols-1'>
        {hours.hasHours && (
          <div id='hours' data-scroll-anchor class:list={['reveal', blockCls]}>
            <div class='flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-2 min-h-[32px]'>
              <h3 class='label'>{hours.strings.hours}</h3>
              <p data-open-status class='status-badge'>
                <span class='status-dot' aria-hidden='true'></span>
                <span class='font-semibold' data-status-label></span>
                <span data-status-detail></span>
              </p>
            </div>
            <HoursList hours={hours} />
          </div>
        )}

        {dir.calle && (
          <div class:list={['reveal', blockCls]}>
            <h3 class='label mb-3'>{tt.address}</h3>
            <p class='font-serif text-ink text-[21px] leading-[1.3]'>{dir.calle}</p>
            <p class='text-muted text-[15.5px] mt-1'>{[dir.codigoPostal, dir.ciudad].filter(Boolean).join(' · ')}</p>
            {dir.barrio && <p class='text-muted italic text-[15.5px]'>{dir.barrio}</p>}
          </div>
        )}

        {phone && (
          <div class:list={['reveal', blockCls]}>
            <h3 class='label mb-2'>{tt.phone}</h3>
            <a
              href={telHref(phone)}
              class='inline-flex items-center min-h-[36px] font-serif text-ink text-[21px] tabular-nums underline decoration-line-strong underline-offset-[5px] cursor-pointer transition-colors duration-200 hover:text-accent hover:decoration-accent'
            >
              {phone}
            </a>
          </div>
        )}

        {mapsUrl && (
          <div class='reveal pt-7 max-[960px]:pt-0 max-[960px]:self-end'>
            <CtaButton href={mapsUrl} target='_blank' rel='noopener' variant='outline' class='max-[600px]:w-full'>
              {tt.directions}
            </CtaButton>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Un iframe de otro origen nunca casa con :focus, así que al llegar con Tab
  // no se vería dónde está el foco. Se marca a mano, solo si se llegó con teclado.
  (function () {
    const frame = document.querySelector('[data-map-frame]');
    if (!frame) return;
    let lastTab = 0;
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') lastTab = Date.now();
    });
    window.addEventListener('blur', () => {
      if (document.activeElement === frame && Date.now() - lastTab < 200) frame.setAttribute('data-kbd-focus', '');
    });
    window.addEventListener('focus', () => frame.removeAttribute('data-kbd-focus'));
  })();
</script>
