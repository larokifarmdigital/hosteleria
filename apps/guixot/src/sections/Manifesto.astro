---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant, Espacio } from '../lib/queries';
import Tag from '../components/Tag.astro';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  locale: string;
  defaultLocale: string;
}

const { restaurant, espacio, locale, defaultLocale } = Astro.props;
const eyebrow = t(espacio.manifiestoEyebrow, locale, defaultLocale);
const text = t(espacio.manifiestoTexto, locale, defaultLocale);
---

<!-- Cita centrada, enmarcada por dos filetes navy y firmada con el nombre. -->
{text && (
  <section class='section-y px-(--gap) bg-bg-2 border-y border-line'>
    <figure class='stagger max-w-[900px] mx-auto text-center'>
      {eyebrow && (
        <div class='reveal flex items-center justify-center gap-4 mb-9'>
          <span aria-hidden='true' class='w-14 h-px bg-accent max-[600px]:w-6'></span>
          <Tag as='p'>{eyebrow}</Tag>
          <span aria-hidden='true' class='w-14 h-px bg-accent max-[600px]:w-6'></span>
        </div>
      )}

      <blockquote class='reveal font-serif font-light italic leading-[1.22] text-ink text-[clamp(27px,3.9vw,50px)]'>
        <span aria-hidden='true' class='text-accent-alt not-italic font-medium'>“</span>{text}<span aria-hidden='true' class='text-accent-alt not-italic font-medium'>”</span>
      </blockquote>

      <figcaption class='reveal mt-9 font-serif italic text-muted text-[18px]'>— {restaurant.nombre}</figcaption>
    </figure>
  </section>
)}
