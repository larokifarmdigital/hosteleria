---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/sanity';
import type { Restaurant, Espacio } from '../lib/queries';
import Tag from '../components/Tag.astro';
import CtaButton from '../components/CtaButton.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  locale: string;
  defaultLocale: string;
}

const { restaurant, espacio, locale, defaultLocale } = Astro.props;
const heroImgUrl = img.url(espacio.heroImagen) ?? '/img/hero.jpg';
const heroTitle = t(espacio.heroTitulo, locale, defaultLocale);
const heroSubtitle = t(espacio.heroSubtitulo, locale, defaultLocale);
const bookingAction = resolveBookingAction(restaurant, locale);
---

<!--
  Guixot Hero: layout HORIZONTAL editorial.
  - hero-top: tags decorativas alineadas
  - hero-body: 2 columnas (texto + foto), CTA integrado al final del texto
-->
<header id="top" class="relative overflow-hidden pt-24 pb-20 px-(--gap) max-[900px]:pt-20 max-[900px]:pb-14">
  <!-- Blobs decorativos muy sutiles (navy + brass) para dar profundidad -->
  <div class="blob blob-navy w-[520px] h-[520px] -top-24 -right-40 max-[900px]:w-[360px] max-[900px]:h-[360px] max-[900px]:-right-24"></div>
  <div class="blob blob-brass w-[300px] h-[300px] bottom-4 -left-24 max-[900px]:hidden"></div>

  <div class="relative z-[1] mx-auto max-w-[var(--max)]">

    <!-- ▸ hero-top: rule + tag + tag alineados horizontal -->
    <div class="flex items-center gap-4 mb-12 max-[700px]:flex-wrap max-[700px]:gap-2">
      <span class="w-[60px] h-px bg-line-strong flex-shrink-0"></span>
      <Tag class="!before:hidden">
        {t(espacio.heroMetaIzq, locale, defaultLocale)}
      </Tag>
      <span class="text-dim opacity-60">·</span>
      <Tag class="!before:hidden">
        {t(espacio.heroMetaDer, locale, defaultLocale)}
      </Tag>
    </div>

    <!-- ▸ hero-body: título + descripción + CTA a la izquierda, foto a la derecha -->
    <div class="grid grid-cols-[1.1fr_1fr] gap-[clamp(40px,6vw,96px)] items-center max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <div class="flex flex-col gap-8">
        <h1 class="font-serif font-medium leading-[0.95] tracking-[-0.02em] text-[clamp(56px,8vw,124px)]">
          <span class="block">{heroTitle}</span>
          <span class="block italic text-accent font-normal">{heroSubtitle}</span>
        </h1>
        <p
          class="text-ink-soft text-[17px] leading-[1.7] max-w-[42ch]"
          set:html={t(espacio.heroNota, locale, defaultLocale).replace(/\n/g, '<br />')}
        />
        {bookingAction && (
          <div class="max-[900px]:self-start">
            <CtaButton
              href={bookingAction.href}
              target={bookingAction.external ? '_blank' : undefined}
              rel={bookingAction.external ? 'noopener' : undefined}
            >
              {t(espacio.heroCta, locale, defaultLocale)}
            </CtaButton>
          </div>
        )}
      </div>
      <figure class="relative aspect-[4/5] overflow-hidden bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)] max-[900px]:aspect-[4/3]">
        <img src={heroImgUrl} alt={heroTitle} fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
      </figure>
    </div>

  </div>
</header>
