---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/sanity';
import type { Restaurant, Espacio } from '../lib/queries';
import { buildHoursByDay } from '@hosteleria/utils';
import Tag from '../components/Tag.astro';
import CtaButton from '../components/CtaButton.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  locale: string;
  defaultLocale: string;
}

const { restaurant, espacio, locale, defaultLocale } = Astro.props;
const heroImgUrl = img.url(espacio.heroImagen) ?? '/img/hero.jpg';
const heroTitle = t(espacio.heroTitulo, locale, defaultLocale);
const heroSubtitle = t(espacio.heroSubtitulo, locale, defaultLocale);
const metaIzq = t(espacio.heroMetaIzq, locale, defaultLocale);
const metaDer = t(espacio.heroMetaDer, locale, defaultLocale);
const bookingAction = resolveBookingAction(restaurant, locale);

// Chip flotante "Estamos abiertos": datos para el script inline
const hoursByDay = buildHoursByDay(espacio.horariosSemana);
const scheduleMessages = {
  abierto: t(espacio.horariosAbierto, locale, defaultLocale) || 'Abierto hasta las {hora}.',
  proxima: t(espacio.horariosProximaApertura, locale, defaultLocale) || 'Hoy abrimos a las {hora}.',
  cerrado: t(espacio.horariosCerrado, locale, defaultLocale) || 'Cerrado hoy.'
};
const hasHorarios = Boolean(espacio.horariosSemana?.length);
---

<!--
  Guixot Hero: layout HORIZONTAL editorial.
  - hero-top: tags decorativas alineadas
  - hero-body: 2 columnas (texto + foto), CTA integrado al final del texto
  - chip flotante "Abierto/Cerrado" en esquina inf-izq de la foto (dinámico)
-->
<header id="top" class="relative overflow-hidden pt-28 pb-20 px-(--gap) max-[900px]:pt-24 max-[900px]:pb-14">
  <div class="relative z-[1] mx-auto max-w-[var(--max)]">

    <!-- ▸ hero-top: dos Tags de corrido con separador punto -->
    <div class="flex items-center gap-4 mb-12 max-[700px]:flex-wrap max-[700px]:gap-2">
      {metaIzq && <Tag>{metaIzq}</Tag>}
      {metaIzq && metaDer && <span class="text-dim opacity-60">·</span>}
      {metaDer && <Tag>{metaDer}</Tag>}
    </div>

    <!-- ▸ hero-body: título + descripción + CTA a la izquierda, foto a la derecha -->
    <div class="grid grid-cols-[1.1fr_1fr] gap-[clamp(40px,6vw,96px)] items-center max-[900px]:grid-cols-1 max-[900px]:gap-10">
      <div class="flex flex-col gap-8">
        <h1 class="font-serif font-medium leading-[0.95] tracking-[-0.02em] text-[clamp(56px,8vw,124px)]">
          <span class="block">{heroTitle}</span>
          <span class="block italic text-accent font-normal">{heroSubtitle}</span>
        </h1>
        <p
          class="text-ink-soft text-[17px] leading-[1.7] max-w-[42ch]"
          set:html={t(espacio.heroNota, locale, defaultLocale).replace(/\n/g, '<br />')}
        />
        {bookingAction && (
          <div class="max-[900px]:self-start">
            <CtaButton
              href={bookingAction.href}
              target={bookingAction.external ? '_blank' : undefined}
              rel={bookingAction.external ? 'noopener' : undefined}
            >
              {t(espacio.heroCta, locale, defaultLocale)}
            </CtaButton>
          </div>
        )}
      </div>

      <div class="relative">
        <figure class="relative aspect-[4/5] overflow-hidden bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)] max-[900px]:aspect-[4/3]">
          <img src={heroImgUrl} alt={heroTitle} fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
        </figure>

        {hasHorarios && (
          <!-- Chip flotante "Estamos abiertos" — esquina inferior izq, sale
               ligeramente de la card para dar look flotante brasserie. -->
          <div
            id="heroOpenChip"
            data-state="loading"
            class="absolute bottom-[-14px] left-6 z-[2] inline-flex items-center gap-2.5 py-2.5 pl-3 pr-4 rounded-full bg-bg border border-line-strong shadow-[var(--shadow-card-lift)] font-sans max-[900px]:left-4 max-[900px]:bottom-[-12px]"
          >
            <span class="relative inline-flex items-center justify-center w-2 h-2 shrink-0">
              <span
                data-ping
                class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-60 animate-ping"
              ></span>
              <span
                data-dot
                class="relative inline-flex rounded-full h-2 w-2 bg-accent"
              ></span>
            </span>
            <span data-text class="text-[12.5px] font-medium tracking-[0.01em] text-ink">…</span>
          </div>
        )}
      </div>
    </div>

  </div>
</header>

{hasHorarios && (
  <script is:inline define:vars={{ hoursByDay, scheduleMessages }}>
    (function () {
      const HOURS = hoursByDay;
      const msg = scheduleMessages;
      const chip = document.getElementById('heroOpenChip');
      if (!chip) return;
      const fmt = n => {
        const h = Math.floor(n);
        const m = Math.round((n - h) * 60);
        return `${h}:${m.toString().padStart(2, '0')}`;
      };
      const now = new Date();
      const d = now.getDay();
      const h = now.getHours() + now.getMinutes() / 60;
      const today = HOURS[d] || [];
      let open = false, nextOpen = null, closesAt = null;
      for (const [a, b] of today) {
        if (h >= a && h < b) { open = true; closesAt = b; break; }
        if (h < a && nextOpen === null) nextOpen = a;
      }
      const line = open
        ? msg.abierto.replace('{hora}', fmt(closesAt))
        : nextOpen !== null
          ? msg.proxima.replace('{hora}', fmt(nextOpen))
          : msg.cerrado;
      const textEl = chip.querySelector('[data-text]');
      if (textEl) textEl.textContent = line;

      chip.dataset.state = open ? 'open' : 'closed';
      // Si está cerrado, el ping y el dot pasan a dim (menos "activo")
      if (!open) {
        chip.querySelector('[data-ping]')?.classList.remove('animate-ping');
        chip.querySelector('[data-dot]')?.classList.remove('bg-accent');
        chip.querySelector('[data-dot]')?.classList.add('bg-dim');
      }
    })();
  </script>
)}
