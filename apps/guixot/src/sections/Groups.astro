---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/content';
import type { Restaurant } from '../lib/queries';
import SectionHeading from '../components/SectionHeading.astro';
import CtaButton from '../components/CtaButton.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
}

const { restaurant, locale, defaultLocale } = Astro.props;
const imageUrl = img.url(restaurant.gruposImagen) ?? '/img/hire.jpg';
const title = t(restaurant.gruposTitulo, locale, defaultLocale);
const bookingAction = resolveBookingAction(restaurant, locale);

// Descripción corta por idioma: el schema no la tiene.
const T: Record<string, string> = {
  es: 'Grupos, celebraciones y menús cerrados. Escríbenos con antelación y preparamos una propuesta a medida.',
  ca: 'Grups, celebracions i menús tancats. Escriu-nos amb antelació i preparem una proposta a mida.',
  en: 'Groups, celebrations and set menus. Write in advance and we will prepare a bespoke proposal.'
};
const description = T[locale] ?? T.es;
---

<!-- Grupos: texto a la izquierda (etiqueta, título, descripción, botón) y foto a la derecha. -->
<section id='groups' class='section-y px-(--gap) bg-bg-2 border-y border-line'>
  <div class='mx-auto max-w-[var(--max)] grid grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] items-center gap-[clamp(40px,6vw,110px)] max-[900px]:grid-cols-1 max-[900px]:gap-11'>
    <div class='flex flex-col items-start gap-8 max-w-[520px] max-[900px]:order-2'>
      <SectionHeading eyebrow={t(restaurant.gruposEyebrow, locale, defaultLocale)} title={title} align='left' />
      <p class='reveal text-ink-soft text-[17px] leading-[1.8] max-w-[46ch]'>{description}</p>
      {bookingAction && (
        <div class='reveal'>
          <CtaButton
            href={bookingAction.href}
            target={bookingAction.external ? '_blank' : undefined}
            rel={bookingAction.external ? 'noopener' : undefined}
          >
            {t(restaurant.gruposCta, locale, defaultLocale) || bookingAction.label}
          </CtaButton>
        </div>
      )}
    </div>

    <div class='relative isolate max-[900px]:order-1'>
      <figure data-reveal='img' class='reveal aspect-[4/5] overflow-hidden bg-surface rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)] max-[900px]:aspect-[4/3]'>
        <img src={imageUrl} alt='' class='w-full h-full object-cover' loading='lazy' decoding='async' />
      </figure>
      <span aria-hidden='true' class='absolute -z-[1] inset-0 -translate-x-4 translate-y-4 border border-accent-alt/70 rounded-[var(--radius-card)] max-[900px]:-translate-x-2.5 max-[900px]:translate-y-2.5'></span>
    </div>
  </div>
</section>
