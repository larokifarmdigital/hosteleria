---
import BaseLayout from '../layouts/BaseLayout.astro';
import RestaurantePage from '../components/RestaurantePage.astro';
import { fetchDataRestaurante } from '../lib/queries';
import { img } from '../lib/sanity';
import { t, resolveActiveLocales, localizedPath } from '@hosteleria/i18n-utils';

const data = await fetchDataRestaurante();
const { restaurante } = data;
const defaultLocale = restaurante.idiomaPorDefecto?.codigo ?? 'es';
const locale = defaultLocale;

const activeLocales = restaurante.idiomasActivos?.length
  ? restaurante.idiomasActivos
  : [{ codigo: defaultLocale, nombre: defaultLocale }];

const siteUrl = restaurante.dominio ?? 'https://lapubilla.example.com';
const canonical = `${siteUrl}${localizedPath('/', locale, defaultLocale)}`;

const hreflangs = resolveActiveLocales(
  defaultLocale,
  activeLocales.map((l) => l.codigo),
).map((l) => ({
  locale: l,
  url: `${siteUrl}${localizedPath('/', l, defaultLocale)}`,
}));

const seoTitle = t(restaurante.seoTitulo, locale, defaultLocale) || restaurante.nombre;
const seoDescription = t(restaurante.seoDescripcion, locale, defaultLocale) || '';
const ogImage = img.url(restaurante.seoImagen) ?? img.url(restaurante.heroImagen);
const logoUrl = img.url(restaurante.logo);
const faviconUrl = img.url(restaurante.favicon);
const appleTouchIconUrl = img.pngSquare(restaurante.iconoApp, 180);
const themeColor = restaurante.colorMarca;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurante.nombre,
  ...(logoUrl && { logo: logoUrl }),
  ...(ogImage && { image: ogImage }),
  ...(restaurante.direccion && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: restaurante.direccion.calle,
      addressLocality: restaurante.direccion.ciudad,
      postalCode: restaurante.direccion.codigoPostal,
      addressCountry: restaurante.direccion.pais,
    },
  }),
  ...(restaurante.contacto?.telefono && { telephone: restaurante.contacto.telefono }),
  url: canonical,
};
---

<BaseLayout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  ogImage={ogImage}
  hreflangs={hreflangs}
  jsonLd={jsonLd}
  faviconUrl={faviconUrl}
  appleTouchIconUrl={appleTouchIconUrl}
  themeColor={themeColor}
>
  <RestaurantePage
    locale={locale}
    defaultLocale={defaultLocale}
    activeLocales={activeLocales}
    {...data}
  />
</BaseLayout>
