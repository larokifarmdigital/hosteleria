---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/sanity';
import type { Restaurant } from '../lib/queries';
import { extractI18nParagraphs } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
}

const { restaurant, locale, defaultLocale } = Astro.props;

// Hasta 3 imágenes (schema limita a 3). Placeholder solo si no hay ninguna.
const imagesInput = (restaurant.sobreImagenes ?? [])
  .slice(0, 3)
  .map(i => img.url(i))
  .filter((u): u is string => Boolean(u));
const images = imagesInput.length > 0 ? imagesInput : ['/img/gal-room.jpg'];

const eyebrow = t(restaurant.sobreEyebrow, locale, defaultLocale);
const titulo = t(restaurant.sobreTitulo, locale, defaultLocale);
const paragraphs = extractI18nParagraphs(restaurant.sobreCuerpo, locale, defaultLocale);
const location = restaurant.direccion?.barrio || restaurant.direccion?.ciudad;

const imgShadow = 'shadow-[0_18px_44px_-16px_rgb(34_20_26/0.28)]';
---

<!--
  About: stack vertical secuencial. Ninguna imagen se estira a full-bleed
  panorámico (evita pixelación de fotos pequeñas subidas por el cliente).

    Header ornamental (con etiqueta "barrio" bajo el título)
    ↓
    Texto centrado en columna estrecha (680px) con drop-cap
    ↓
    Bloque de imágenes abajo, siempre en fila horizontal centrada, max-w-1080:
      · 1 imagen  → centrada aspect 4/5, ancho contenido (max-w-560)
      · 2 imágenes → díptico aspect 4/5 side-by-side
      · 3 imágenes → tríptico aspect 4/5 en 3 columnas
    ↓
    Cierre ornamental
-->
<section
  id='about'
  class='mx-auto pt-[8vh] pb-[14vh] px-(--gap) max-w-[var(--max)] max-[960px]:pt-[4vh] max-[960px]:pb-[10vh]'
>
  <!-- Header centrado ornamental con etiqueta barrio bajo el título -->
  <div class='reveal text-center mb-[9vh] max-[960px]:mb-10'>
    <div class='flex items-center justify-center gap-3 mb-6'>
      <span class='w-12 h-px bg-accent/60'></span>
      <span class='text-accent-alt text-sm leading-none'>❦</span>
      <span class='w-12 h-px bg-accent/60'></span>
    </div>
    <span class='block font-sans uppercase text-[11px] tracking-[0.32em] text-accent font-medium mb-4'>
      {eyebrow}
    </span>
    <h2
      class='font-serif font-normal leading-[0.95] tracking-[-0.01em] text-[clamp(38px,5vw,72px)] max-w-[20ch] mx-auto'
    >
      {titulo}
    </h2>
    {location && (
      <div class='flex items-center justify-center gap-3 mt-6'>
        <span class='w-8 h-px bg-accent-alt'></span>
        <span class='font-serif italic text-accent-alt text-[14px] tracking-wide'>
          {location}
        </span>
        <span class='w-8 h-px bg-accent-alt'></span>
      </div>
    )}
  </div>

  <!-- TEXTO CENTRADO — columna de lectura editorial estrecha -->
  {paragraphs.length > 0 && (
    <div class='reveal mx-auto max-w-[680px]'>
      {paragraphs.map((p, i) => (
        <p
          class:list={[
            'text-ink-soft text-[17px] leading-[1.85] font-sans',
            i === 0 ? '' : 'mt-6'
          ]}
        >
          {i === 0 && (
            <span class='float-left font-serif italic text-accent leading-none text-[76px] mr-3 mt-2 max-[700px]:text-[62px]'>
              {p.charAt(0)}
            </span>
          )}
          {i === 0 ? p.slice(1) : p}
        </p>
      ))}
    </div>
  )}

  <!-- BLOQUE DE IMÁGENES · siempre en fila horizontal centrada.
       Composición 1/2/3 se resuelve con grid-cols dinámico. Sin full-bleed
       para respetar la resolución original de las fotos del cliente. -->
  <div
    class='reveal mx-auto mt-[9vh] max-[960px]:mt-12'
    class:list={[
      images.length === 1 && 'max-w-[560px]',
      images.length === 2 && 'max-w-[900px]',
      images.length === 3 && 'max-w-[1080px]'
    ]}
  >
    <div
      class:list={[
        'grid gap-[clamp(20px,3vw,32px)] max-[700px]:grid-cols-1 max-[700px]:gap-5',
        images.length === 1 && 'grid-cols-1',
        images.length === 2 && 'grid-cols-2',
        images.length === 3 && 'grid-cols-3'
      ]}
    >
      {images.map(src => (
        <div class:list={['aspect-[4/5] overflow-hidden bg-surface', imgShadow]}>
          <img src={src} alt='' class='w-full h-full object-cover' />
        </div>
      ))}
    </div>
  </div>

  <!-- Cierre ornamental -->
  <div class='reveal flex items-center justify-center gap-5 mt-[9vh] max-[960px]:mt-12'>
    <span class='w-20 h-px bg-line-strong'></span>
    <span class='text-accent-alt text-xl leading-none font-serif'>❦</span>
    <span class='w-20 h-px bg-line-strong'></span>
  </div>
</section>
