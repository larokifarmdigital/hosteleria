{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/cron/cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/cron/backup",
      "schedule": "0 3 * * *"
    }
  ]
}
