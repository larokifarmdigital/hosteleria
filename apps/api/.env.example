# ═════════════════════════════════════════════════════════════════
# apps/api — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA commitees `.env.local` (está en .gitignore).
# ═════════════════════════════════════════════════════════════════

# ── Neon Postgres ────────────────────────────────────────────────
# Connection string de la BD Neon (branch dev para local, main para prod).
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://neondb_owner:XXXXXX@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Lucia sessions ───────────────────────────────────────────────
# Random 32 bytes hex. Genera con: openssl rand -hex 32
SESSION_SECRET="reemplaza-por-32-bytes-random-en-hex"

# ── Cloudflare R2 (S3 compatible) ────────────────────────────────
# Account ID: 32 chars hex, visible en el sidebar del dashboard R2.
R2_ACCOUNT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Credenciales del API token creado en R2 → "Manage R2 API Tokens".
R2_ACCESS_KEY_ID="XXXXXXXXXXXXXXXXXXXX"
R2_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Nombre del bucket que creaste.
R2_BUCKET="hosteleria-media"
# URL pública del bucket (r2.dev subdomain o dominio custom).
# Ejemplo r2.dev: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Ejemplo custom: https://media.hosteleria.cat
R2_PUBLIC_URL="https://pub-XXXXXXXXXXXXXXXXXXXXX.r2.dev"

# ── Admin inicial para el seed ───────────────────────────────────
# El seed script crea este usuario con rol admin la primera vez.
# Cambia el password al primer login desde el backoffice.
ADMIN_EMAIL="erick@hosteleria.cat"
ADMIN_PASSWORD="cambia-esto-al-primer-login"
ADMIN_NAME="Erick Pineda"

# ── CORS ─────────────────────────────────────────────────────────
# Origen del backoffice que puede llamar al api. Coma-separado si son varios.
# Dev: http://localhost:4400
# Prod: https://studio.hosteleria.cat
ALLOWED_ORIGIN="http://localhost:4400"

# ── Server ───────────────────────────────────────────────────────
# Puerto del server local (dev). En Vercel se ignora.
PORT="8787"

# ── Sentry (opcional) ────────────────────────────────────────────
# Si está vacío, no se instrumenta. Para activar: crea proyecto en
# sentry.io y pega el DSN aquí. SENTRY_ENV discrimina development/preview/production
# en el dashboard de Sentry.
SENTRY_DSN=""
SENTRY_ENV="development"

# ── Cron secret ──────────────────────────────────────────────────
# Vercel Cron envía `authorization: Bearer <CRON_SECRET>` a los endpoints
# bajo /cron/*. Debe coincidir con esta variable.
CRON_SECRET="genera-con-openssl-rand-hex-32"

# ── Email (opcional) ─────────────────────────────────────────────
# Si RESEND_API_KEY está vacío, los emails se loguean en consola.
# Resend: free 3k/mes — crea cuenta en resend.com y pega la API key.
RESEND_API_KEY=""
EMAIL_FROM="Hosteleria Studio <no-reply@hosteleria.cat>"
APP_URL="http://localhost:4400"
