# ═════════════════════════════════════════════════════════════════
# apps/api — variables de entorno (SOLO para desarrollo local)
#
# Copiá este archivo a `.env.local` y rellená los valores reales.
# NUNCA commitees `.env.local` (está en .gitignore).
#
# En PRODUCCIÓN estos valores NO viven en archivos — se setean como
# `wrangler secret put NOMBRE` en Cloudflare. Ver DEPLOY.md.
# ═════════════════════════════════════════════════════════════════

# ── Neon Postgres ────────────────────────────────────────────────
# Connection string de la BD Neon.
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://neondb_owner:XXXXXX@ep-xxxxx.neon.tech/neondb?sslmode=require"

# ── Lucia sessions ───────────────────────────────────────────────
# Random 32 bytes hex. Genera con: openssl rand -hex 32
SESSION_SECRET="reemplaza-por-32-bytes-random-en-hex"

# ── Cloudflare R2 (S3 compatible) — SOLO para presigned URLs ─────
# El binding R2 nativo del Worker usa `env.MEDIA` (configurado en
# wrangler.toml); estas credenciales son para generar presigned PUT
# URLs que el browser consume directo.
R2_ACCOUNT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
R2_ACCESS_KEY_ID="XXXXXXXXXXXXXXXXXXXX"
R2_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
R2_BUCKET="hostelery"
# URL pública del bucket (r2.dev subdomain o dominio custom).
R2_PUBLIC_URL="https://pub-XXXXXXXXXXXXXXXXXXXXX.r2.dev"

# ── Admin inicial para el seed ───────────────────────────────────
# El seed script crea este usuario con rol admin la primera vez.
# Cambia el password al primer login desde el backoffice.
ADMIN_EMAIL="admin@hostelery.com"
ADMIN_PASSWORD="cambia-esto-al-primer-login"
ADMIN_NAME="Admin"

# ── CORS ─────────────────────────────────────────────────────────
# Origen del backoffice. Coma-separado si son varios.
ALLOWED_ORIGIN="http://localhost:4400"

# ── Sentry (opcional) ────────────────────────────────────────────
# Si está vacío, no se instrumenta.
SENTRY_DSN=""
SENTRY_ENV="development"

# ── Cron secret (opcional — no se usa en Workers) ──────────────
# En Workers los crons los invoca el runtime directo (no HTTP), así
# que no necesitan secret. Esta var queda por si en algún momento
# exponés /cron/* como endpoint HTTP protegido.
CRON_SECRET=""

# ── Email (opcional) ─────────────────────────────────────────────
# Si RESEND_API_KEY está vacío, los emails se loguean en consola.
RESEND_API_KEY=""
EMAIL_FROM="Hosteleria Studio <no-reply@hosteleria.cat>"
APP_URL="http://localhost:4400"

# ── Cookie domain (opcional) ─────────────────────────────────────
# Si lo seteás (ej. ".hosteleria.cat"), la cookie de sesión se comparte
# entre subdominios. Vacío = cookie se scopa al host del api.
COOKIE_DOMAIN=""
