# apps/backoffice — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` no se sube al repositorio.
# En Vercel van en Project Settings → Environment Variables.

# ── Neon Postgres ────────────────────────────────────────────────
# URL con pooler (el host lleva `-pooler`).
DATABASE_URL=

# ── Sesiones ─────────────────────────────────────────────────────
# 32 bytes en hex: openssl rand -hex 32
SESSION_SECRET=
# Solo `development` quita `Secure` de la cookie de sesión (http en local).
# En local, sobre http: development
APP_ENV=development
# Opcional. Domain de la cookie (ej. `.hosteleria.cat`). Vacío = el host del backoffice.
COOKIE_DOMAIN=

# ── Cloudflare R2 (API S3) ───────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket (subdominio r2.dev o dominio propio), sin barra final.
R2_PUBLIC_URL=
# Bucket PRIVADO (sin acceso público) para la copia diaria. Sin él la copia no se hace.
R2_BACKUP_BUCKET=

# ── Crons ────────────────────────────────────────────────────────
# Protege /api/cron/*. Vercel Cron lo envía solo si la variable existe en el proyecto.
CRON_SECRET=

# ── Correo (opcional) ────────────────────────────────────────────
# Sin RESEND_API_KEY los correos se escriben en la consola.
RESEND_API_KEY=
EMAIL_FROM="Hosteleria Studio <no-reply@hosteleria.cat>"
# Origen del backoffice: con él se montan los enlaces de invitación y de cambio de contraseña.
APP_URL=http://localhost:4400

# ── Solo para scripts (seed) ─────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# «Ayuda y soporte»: clave de Web3Forms (https://web3forms.com) creada con el correo de soporte.
# Es pública por diseño (solo manda correos a ese buzón). Sin ella, «Enviar» abre el programa de correo con el mensaje.
NEXT_PUBLIC_WEB3FORMS_KEY=
