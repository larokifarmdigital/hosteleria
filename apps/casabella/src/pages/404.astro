---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchRestaurantData } from '../lib/queries';
import { img } from '../lib/sanity';
import { resolveActiveLocales, localizedPath } from '@hosteleria/i18n-utils';

const data = await fetchRestaurantData();
const { restaurant } = data;
const defaultLocale = restaurant.idiomaPorDefecto?.codigo ?? 'es';
const activeLocales = restaurant.idiomasActivos?.length
  ? restaurant.idiomasActivos
  : [{ codigo: defaultLocale, nombre: defaultLocale }];
const locales = resolveActiveLocales(defaultLocale, activeLocales.map((l) => l.codigo));

const siteUrl = restaurant.dominio ?? '';
const canonical = `${siteUrl}/404`;

const faviconUrl = img.url(restaurant.favicon);
const appleTouchIconUrl = img.pngSquare(restaurant.iconoApp, 180);
const themeColor = restaurant.colorMarca;

const COPY: Record<string, { titulo: string; mensaje: string; volver: string }> = {
  es: {
    titulo: 'Página no encontrada',
    mensaje: 'La página que buscas no existe o ha cambiado de dirección.',
    volver: 'Volver al inicio',
  },
  en: {
    titulo: 'Page not found',
    mensaje: 'The page you are looking for does not exist or has moved.',
    volver: 'Back to home',
  },
  ca: {
    titulo: 'Pàgina no trobada',
    mensaje: 'La pàgina que busques no existeix o ha canviat d’adreça.',
    volver: 'Tornar a l’inici',
  },
};
---

<BaseLayout
  locale={defaultLocale}
  title={`404 — ${restaurant.nombre}`}
  description="404"
  canonical={canonical}
  hreflangs={[]}
  faviconUrl={faviconUrl}
  appleTouchIconUrl={appleTouchIconUrl}
  themeColor={themeColor}
  cloudflareAnalyticsToken={restaurant.cloudflareAnalyticsToken}
>
  <main id="main" class="notfound">
    <div class="notfound-inner">
      <p class="notfound-code">404</p>
      <h1 class="notfound-title">{COPY[defaultLocale]?.titulo ?? COPY.es.titulo}</h1>
      <p class="notfound-msg">{COPY[defaultLocale]?.mensaje ?? COPY.es.mensaje}</p>
      <ul class="notfound-links">
        {locales.map((l) => {
          const c = COPY[l] ?? COPY.es;
          const href = localizedPath('/', l, defaultLocale);
          return (
            <li>
              <a href={href}>
                <span class="lang">{l.toUpperCase()}</span>
                <span>{c.volver}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </main>

  <style>
    .notfound {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6rem 1.5rem;
      background: var(--color-fondo, #1a1410);
      color: var(--color-texto, #f2ede4);
    }
    .notfound-inner { max-width: 520px; text-align: center; }
    .notfound-code {
      font-family: var(--font-serif, 'Fraunces', serif);
      font-size: clamp(4rem, 15vw, 8rem);
      font-weight: 300;
      line-height: 1;
      margin: 0 0 1rem;
      color: var(--color-marca, #d4a655);
      letter-spacing: -0.02em;
    }
    .notfound-title {
      font-family: var(--font-serif, 'Fraunces', serif);
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      font-weight: 400;
      margin: 0 0 1rem;
      letter-spacing: -0.01em;
    }
    .notfound-msg {
      font-family: var(--font-sans, 'Inter', sans-serif);
      font-size: 1.05rem;
      opacity: 0.75;
      margin: 0 0 2.5rem;
      line-height: 1.6;
    }
    .notfound-links {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      align-items: center;
    }
    .notfound-links a {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.85rem 1.75rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: inherit;
      text-decoration: none;
      font-family: var(--font-sans, 'Inter', sans-serif);
      font-size: 0.95rem;
      letter-spacing: 0.02em;
      transition: border-color 0.2s, background-color 0.2s;
      min-width: 240px;
      justify-content: center;
    }
    .notfound-links a:hover,
    .notfound-links a:focus-visible {
      border-color: var(--color-marca, #d4a655);
      background: rgba(212, 166, 85, 0.08);
      outline: none;
    }
    .notfound-links .lang {
      font-size: 0.75rem;
      opacity: 0.55;
      letter-spacing: 0.1em;
    }
  </style>
</BaseLayout>
