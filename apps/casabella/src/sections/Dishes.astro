---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant, DishCategory, Dish } from '../lib/queries';
import SectionHeader from '../components/SectionHeader.astro';

interface Props {
  restaurant: Restaurant;
  dishCategories: DishCategory[];
  dishes: Dish[];
  locale: string;
  defaultLocale: string;
}

const { restaurant, dishCategories, dishes, locale, defaultLocale } = Astro.props;

const sec = restaurant.textosSecciones ?? {};

const dishesByCategory = dishCategories
  .map((cat) => ({ category: cat, items: dishes.filter((d) => d.categoria?._id === cat._id) }))
  .filter(({ items }) => items.length > 0);

if (dishesByCategory.length === 0) return null;

const T = {
  es: { sections: 'Secciones de la carta', allergens: '¿Alergias o intolerancias? Pregúntanos antes de pedir.', vat: 'Precios con IVA incluido.' },
  ca: { sections: 'Seccions de la carta', allergens: 'Al·lèrgies o intoleràncies? Pregunta’ns abans de demanar.', vat: 'Preus amb IVA inclòs.' },
  en: { sections: 'Menu sections', allergens: 'Allergies or intolerances? Ask us before ordering.', vat: 'Prices include VAT.' }
};
const tt = T[locale as keyof typeof T] ?? T.es;

const priceFormat = new Intl.NumberFormat(locale, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
---

<section id='plates' class='section-y px-(--gap)'>
  <div class='mx-auto max-w-[var(--max)]'>
    <SectionHeader
      eyebrow={t(sec.platosEyebrow, locale, defaultLocale)}
      title={t(sec.platosTitulo, locale, defaultLocale) || 'Carta'}
    />

    <!-- Atajos a cada sección: se quedan pegados bajo el nav mientras se lee
         la carta, y en móvil se deslizan en horizontal. -->
    {dishesByCategory.length > 1 && (
      <nav
        aria-label={tt.sections}
        class='sticky z-30 top-[calc(var(--nav-h)-8px)] -mx-(--gap) px-(--gap) mb-10 bg-bg/95 backdrop-blur-sm border-y border-line'
      >
        <ul class='flex gap-2 py-2.5 overflow-x-auto list-none [scrollbar-width:none] [&::-webkit-scrollbar]:hidden'>
          {dishesByCategory.map(({ category }) => (
            <li class='shrink-0'>
              <a
                href={`#plate-cat-${category._id}`}
                data-menu-tab
                class='inline-flex items-center min-h-[44px] px-4 rounded-full font-sans font-semibold text-[14.5px] text-muted cursor-pointer
                       transition-colors duration-200 hover:text-ink hover:bg-surface-2
                       aria-[current=true]:bg-ink aria-[current=true]:text-bg'
              >
                {t(category.nombre, locale, defaultLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class='grid grid-cols-2 gap-x-[clamp(48px,7vw,112px)] gap-y-14 max-[900px]:grid-cols-1 max-[900px]:gap-y-11'>
      {dishesByCategory.map(({ category, items }) => (
        <div
          id={`plate-cat-${category._id}`}
          data-menu-section
          class='scroll-mt-[calc(var(--nav-h)+84px)]'
        >
          <h3 class='reveal font-serif font-normal italic text-warm text-[clamp(26px,2.4vw,32px)] leading-tight pb-3 mb-2 border-b border-line-strong'>
            {t(category.nombre, locale, defaultLocale)}
          </h3>

          <ul class='stagger list-none divide-y divide-line'>
            {items.map((dish) => {
              const note = t(dish.nota, locale, defaultLocale);
              return (
                <li class='reveal py-4'>
                  <div class='menu-row'>
                    <span class='font-serif text-ink text-[clamp(18px,1.55vw,20.5px)] leading-snug tracking-[-0.005em]'>
                      {t(dish.nombre, locale, defaultLocale)}
                    </span>
                    <span class='leader' aria-hidden='true'></span>
                    {dish.precio != null && (
                      <span class='price text-[16px]'>{priceFormat.format(dish.precio)} €</span>
                    )}
                  </div>
                  {note && <p class='mt-1 text-muted text-[15px] leading-[1.5] pr-14'>{note}</p>}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <p class='mt-12 pt-6 border-t border-line text-muted text-[14.5px] leading-relaxed'>
      {tt.allergens} {tt.vat}
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    const tabs = Array.from(document.querySelectorAll('[data-menu-tab]'));
    if (!tabs.length || !('IntersectionObserver' in window)) return;
    const byId = new Map(tabs.map((tab) => [tab.getAttribute('href').slice(1), tab]));
    const setCurrent = (id) => {
      tabs.forEach((tab) => tab.removeAttribute('aria-current'));
      const tab = byId.get(id);
      if (!tab) return;
      tab.setAttribute('aria-current', 'true');
      // Solo desplaza la fila de pestañas, nunca la página.
      const list = tab.closest('ul');
      const offset = tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2;
      list.scrollTo({ left: offset, behavior: 'smooth' });
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-25% 0px -65% 0px' }
    );
    document.querySelectorAll('[data-menu-section]').forEach((el) => io.observe(el));
  })();
</script>
