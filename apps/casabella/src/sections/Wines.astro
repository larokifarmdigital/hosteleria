---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant, WineCategory, Wine } from '../lib/queries';
import SectionHeader from '../components/SectionHeader.astro';

interface Props {
  restaurant: Restaurant;
  wineCategories: WineCategory[];
  wines: Wine[];
  locale: string;
  defaultLocale: string;
}

const { restaurant, wineCategories, wines, locale, defaultLocale } = Astro.props;

const sec = restaurant.textosSecciones ?? {};

const winesByCategory = wineCategories
  .map((cat) => ({ category: cat, items: wines.filter((w) => w.categoria?._id === cat._id) }))
  .filter(({ items }) => items.length > 0);

if (winesByCategory.length === 0) return null;

const T = {
  es: { glass: 'Copa', bottle: 'Botella' },
  ca: { glass: 'Copa', bottle: 'Ampolla' },
  en: { glass: 'Glass', bottle: 'Bottle' }
};
const tt = T[locale as keyof typeof T] ?? T.es;

// El precio llega como número o texto libre: solo se le añade € si es una cifra.
const price = (value: unknown) => {
  if (value == null || value === '') return null;
  const text = String(value).trim();
  return /^\d+([.,]\d+)?$/.test(text) ? `${text} €` : text;
};

const colCls = 'w-[68px] text-right max-[420px]:w-[58px]';
---

<section id='wines' class='section-y px-(--gap) bg-surface-2'>
  <div class='mx-auto max-w-[var(--max)]'>
    <SectionHeader
      eyebrow={t(sec.vinosEyebrow, locale, defaultLocale)}
      title={t(sec.vinosTitulo, locale, defaultLocale) || 'Vinos'}
      note={t(sec.vinosNotaFinal, locale, defaultLocale)}
    />

    <div class='grid grid-cols-2 gap-x-[clamp(48px,7vw,112px)] gap-y-14 max-[900px]:grid-cols-1 max-[900px]:gap-y-11'>
      {winesByCategory.map(({ category, items }) => (
        <div class='reveal'>
          <!-- Copa y botella se rotulan en cada bloque: también se ven en móvil. -->
          <div class='flex items-end gap-4 pb-3 mb-2 border-b border-line-strong'>
            <h3 class='flex-1 font-serif font-normal italic text-warm text-[clamp(26px,2.4vw,32px)] leading-tight'>
              {t(category.nombre, locale, defaultLocale)}
            </h3>
            <span aria-hidden='true' class:list={[colCls, 'text-muted text-[13px] font-semibold pb-1']}>{tt.glass}</span>
            <span aria-hidden='true' class:list={[colCls, 'text-muted text-[13px] font-semibold pb-1']}>{tt.bottle}</span>
          </div>

          <ul class='stagger list-none divide-y divide-line'>
            {items.map((wine) => {
              const note = [t(wine.nota, locale, defaultLocale), wine.region].filter(Boolean).join(' · ');
              const glass = price(wine.precioCopa);
              const bottle = price(wine.precioBotella);
              return (
                <li class='reveal flex items-baseline gap-4 py-4'>
                  <div class='flex-1 min-w-0'>
                    <span class='block font-serif text-ink text-[clamp(18px,1.55vw,20.5px)] leading-snug'>
                      {wine.nombre}
                    </span>
                    {note && <span class='block mt-1 text-muted text-[15px] leading-[1.5]'>{note}</span>}
                  </div>
                  <span class:list={[colCls, 'price text-[16px]']}>
                    {glass ? <><span class='sr-only'>{tt.glass}: </span>{glass}</> : <span aria-hidden='true' class='text-dim font-normal'>—</span>}
                  </span>
                  <span class:list={[colCls, 'price text-[16px]']}>
                    {bottle ? <><span class='sr-only'>{tt.bottle}: </span>{bottle}</> : <span aria-hidden='true' class='text-dim font-normal'>—</span>}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
