---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/sanity';
import type { Restaurant } from '../lib/queries';
import { extractI18nParagraphs } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
}

const { restaurant, locale, defaultLocale } = Astro.props;

const imagesInput = (restaurant.sobreImagenes ?? [])
  .slice(0, 2)
  .map(i => img.url(i))
  .filter((u): u is string => Boolean(u));
const images = imagesInput.length > 0 ? imagesInput : ['/img/gal-room.jpg'];

const eyebrow = t(restaurant.sobreEyebrow, locale, defaultLocale);
const titulo = t(restaurant.sobreTitulo, locale, defaultLocale);
const paragraphs = extractI18nParagraphs(restaurant.sobreCuerpo, locale, defaultLocale);

const [emph, ...restTitle] = titulo.split(' ');
const restText = restTitle.join(' ');

const figureCls = 'overflow-hidden bg-surface-2 rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)]';
---

<section id='about' class='section-y px-(--gap)'>
  <div
    class='mx-auto max-w-[var(--max)] grid grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] items-center gap-[clamp(40px,7vw,120px)] max-[960px]:grid-cols-1 max-[960px]:gap-10'
  >
    <div class='reveal flex flex-col' data-reveal='left'>
      {eyebrow && <p class='eyebrow mb-5'>{eyebrow}</p>}

      <h2 class='h-section mb-8 max-[960px]:mb-6'>
        <em>{emph}</em>{restText && ' ' + restText}
      </h2>

      {
        paragraphs.length > 0 && (
          <div class='flex flex-col gap-5 max-w-[58ch]'>
            {paragraphs.map((p, i) => (
              <p
                class:list={[
                  'leading-[1.75]',
                  i === 0 ? 'text-ink-soft text-[18px]' : 'text-muted text-[16.5px]'
                ]}
              >
                {p}
              </p>
            ))}
          </div>
        )
      }
    </div>

    <!-- Una foto, o dos solapadas: la segunda baja y monta sobre la primera. -->
    <div class:list={['relative', images.length > 1 && 'pb-[14%] pr-[12%]']}>
      <figure data-reveal='img' class:list={['reveal', figureCls, 'aspect-[4/5]']}>
        <img src={images[0]} alt='' class='w-full h-full object-cover' loading='lazy' decoding='async' />
      </figure>
      {images.length > 1 && (
        <figure data-reveal='img' style='--d:250ms' class:list={['reveal', figureCls, 'absolute bottom-0 right-0 w-[46%] aspect-square border-[6px] border-bg']}>
          <img src={images[1]} alt='' class='w-full h-full object-cover' loading='lazy' decoding='async' />
        </figure>
      )}
    </div>
  </div>
</section>
