---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant } from '../lib/queries';
import Eyebrow from '@hosteleria/ui/components/Eyebrow.astro';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
}

const { restaurant, locale, defaultLocale } = Astro.props;

if (!restaurant.faq?.length) return null;

const eyebrowText =
  locale === 'en' ? 'Frequently asked questions' :
  locale === 'ca' ? 'Preguntes freqüents' :
  'Preguntas frecuentes';

const titleText =
  locale === 'en' ? { first: 'Everything', rest: 'you need to know' } :
  locale === 'ca' ? { first: 'Tot',         rest: 'el que has de saber' } :
                    { first: 'Todo',        rest: 'lo que necesitas saber' };
---

<section
  id='faq'
  class='relative overflow-hidden py-[16vh] px-(--gap) max-[700px]:py-[10vh]'
>
  <div class='blob blob-cream w-[720px] h-[720px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 max-[960px]:w-[520px] max-[960px]:h-[520px]'></div>

  <div class='relative z-[1] mx-auto max-w-[880px]'>
    <div class='reveal text-center mb-14 max-[700px]:mb-10'>
      <Eyebrow class='block mb-5'>{eyebrowText}</Eyebrow>
      <h2 class='font-serif font-normal leading-[1.05] tracking-[-0.02em] text-[clamp(34px,4.2vw,56px)] text-ink'>
        <em class='italic text-warm font-normal'>{titleText.first}</em> {titleText.rest}
      </h2>
    </div>

    <!-- Lista editorial: hairline entre filas, sin pill, toggle "+" fino -->
    <div class='border-t border-line'>
      {restaurant.faq.map((item, i) => (
        <details
          class="reveal group border-b border-line transition-colors duration-[300ms]
                 hover:bg-[rgb(226_216_198/0.35)]"
        >
          <summary
            class="grid items-baseline grid-cols-[36px_1fr_auto] gap-5 py-6 px-2 cursor-pointer list-none
                   [&::-webkit-details-marker]:hidden
                   max-[700px]:grid-cols-[28px_1fr_auto] max-[700px]:gap-3 max-[700px]:py-5 max-[700px]:px-1"
          >
            <span class='font-sans text-warm font-medium text-[11px] tracking-[0.24em] uppercase'>
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class='font-serif text-ink font-normal leading-[1.4] text-[clamp(17px,1.7vw,20px)] tracking-[-0.005em]'>
              {t(item.pregunta, locale, defaultLocale)}
            </span>
            <span
              aria-hidden='true'
              class='inline-flex items-center justify-center w-6 h-6 text-ink
                     transition-[transform] duration-[400ms] ease-[cubic-bezier(.65,0,.35,1)]
                     group-open:rotate-45
                     motion-reduce:transition-none'
            >
              <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.4' stroke-linecap='round'>
                <path d='M12 5v14M5 12h14' />
              </svg>
            </span>
          </summary>
          <div
            class='faq-body overflow-hidden opacity-0 -translate-y-1.5 h-0 will-change-[height]
                   transition-[height,opacity,transform] duration-[420ms] ease-[cubic-bezier(.65,0,.35,1)]
                   group-open:opacity-100 group-open:translate-y-0
                   motion-reduce:transition-none'
          >
            <p class='text-muted text-[15px] leading-[1.8] max-w-[62ch] pl-14 pr-10 pb-7 max-[700px]:pl-10 max-[700px]:pr-2 max-[700px]:pb-5'>
              {t(item.respuesta, locale, defaultLocale)}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('details.reveal').forEach((details) => {
      const summary = details.querySelector('summary');
      const body = details.querySelector('.faq-body');
      if (!summary || !body) return;
      summary.addEventListener('click', (e) => {
        if (reduce) return;
        e.preventDefault();
        const isOpen = details.hasAttribute('open');
        body.style.height = body.scrollHeight + 'px';
        if (isOpen) {
          requestAnimationFrame(() => { body.style.height = '0px'; });
          body.addEventListener('transitionend', function once(ev) {
            if (ev.propertyName !== 'height') return;
            body.removeEventListener('transitionend', once);
            details.removeAttribute('open');
            body.style.height = '';
          });
        } else {
          details.setAttribute('open', '');
          body.style.height = '0px';
          requestAnimationFrame(() => {
            body.style.height = body.scrollHeight + 'px';
          });
          body.addEventListener('transitionend', function once(ev) {
            if (ev.propertyName !== 'height') return;
            body.removeEventListener('transitionend', once);
            body.style.height = 'auto';
          });
        }
      });
    });
  })();
</script>
