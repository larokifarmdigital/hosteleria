---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/sanity';
import type { Restaurant, Espacio } from '../lib/queries';
import Eyebrow from '@hosteleria/ui/components/Eyebrow.astro';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  locale: string;
  defaultLocale: string;
}

const { restaurant, espacio, locale, defaultLocale } = Astro.props;

const sec = restaurant.textosSecciones ?? {};

const galeriaFallback = [
  '/img/gal-table.jpg', '/img/gal-room.jpg', '/img/gal-soup.jpg',
  '/img/gal-martini.jpg', '/img/cellar.jpg', '/img/pass.jpg',
  '/img/glass.jpg', '/img/hire.jpg', '/img/kitchen.jpg'
];
const galeriaImgs = espacio.galeria?.length
  ? espacio.galeria.map((g) => img.url(g) ?? '/img/gal-room.jpg')
  : galeriaFallback;

const titulo = t(sec.galeriaTitulo, locale, defaultLocale) || 'Nuestro espacio';
const [first, ...restTitle] = titulo.split(' ');
const restText = restTitle.join(' ');
---

<section id='gallery' class='py-[16vh] px-(--gap) bg-surface-2 max-[960px]:py-[10vh]'>
  <div class='mx-auto max-w-[var(--max)]'>
    <div class='reveal text-center mb-14 max-[960px]:mb-10'>
      <Eyebrow class='block mb-5'>{t(sec.galeriaEyebrow, locale, defaultLocale)}</Eyebrow>
      <h2 class='font-serif font-normal leading-[1.05] tracking-[-0.02em] text-[clamp(38px,5vw,64px)] text-ink'>
        <em class='italic text-warm font-normal'>{first}</em>{restText && ' ' + restText}
      </h2>
    </div>

    <div class='grid grid-cols-3 gap-3 auto-rows-[260px] max-[960px]:grid-cols-2 max-[960px]:gap-2.5 max-[960px]:auto-rows-[220px] max-[600px]:grid-cols-1 max-[600px]:auto-rows-[280px]'>
      {galeriaImgs.map((src) => (
        <div
          data-gallery-item
          class='group relative overflow-hidden bg-surface cursor-zoom-in rounded-[var(--radius-card)] border border-line shadow-[var(--shadow-card)]
                 transition-[box-shadow,border-color] duration-[400ms] ease-out
                 hover:shadow-[var(--shadow-card-lift)] hover:border-warm/40
                 [&:nth-child(6n+1)]:row-span-2 [&:nth-child(6n+4)]:row-span-2
                 max-[960px]:[&:nth-child(6n+1)]:row-span-1 max-[960px]:[&:nth-child(6n+4)]:row-span-1'
        >
          <img
            src={src} alt='' loading='lazy'
            class='w-full h-full object-cover transition-[transform] duration-[900ms] ease-[cubic-bezier(.2,.6,.2,1)] group-hover:scale-[1.04]'
          />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox editorial -->
<div
  id='lightbox'
  data-open='false'
  class="fixed inset-0 z-[200] grid place-items-center cursor-zoom-out
         invisible opacity-0
         bg-[rgb(33_22_16/0.9)] backdrop-blur-sm
         transition-[opacity,visibility] duration-[400ms] delay-[400ms]
         data-[open='true']:visible data-[open='true']:opacity-100 data-[open='true']:delay-0"
>
  <img src='' alt='' class='w-auto max-w-[88vw] h-auto max-h-[86vh] object-contain' />
</div>

<script is:inline>
  (function () {
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const lbi = lb.querySelector('img');
    const setOpen = (open) => { lb.dataset.open = open ? 'true' : 'false'; };
    document.querySelectorAll('[data-gallery-item]').forEach((c) => {
      const inner = c.querySelector('img');
      if (!inner) return;
      c.addEventListener('click', () => {
        lbi.src = inner.src;
        setOpen(true);
      });
    });
    lb.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
