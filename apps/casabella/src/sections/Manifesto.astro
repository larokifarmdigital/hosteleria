---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant, Espacio } from '../lib/queries';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  locale: string;
  defaultLocale: string;
}

const { espacio, locale, defaultLocale } = Astro.props;

const eyebrow = t(espacio.manifiestoEyebrow, locale, defaultLocale);
const texto = t(espacio.manifiestoTexto, locale, defaultLocale);
---

{texto && (
  <section class='section-y px-(--gap)'>
    <figure class='stagger mx-auto max-w-[920px] flex flex-col items-center text-center'>
      <span
        aria-hidden='true'
        class='reveal font-serif italic text-warm leading-none text-[clamp(72px,9vw,120px)] h-[0.55em] select-none'
      >“</span>
      <blockquote
        class='reveal font-serif text-ink font-normal leading-[1.28] text-[clamp(25px,3.1vw,42px)] tracking-[-0.015em] text-balance'
      >
        {texto}
      </blockquote>
      {eyebrow && (
        <figcaption class='reveal mt-9 flex items-center gap-4 max-[960px]:mt-7'>
          <span aria-hidden='true' class='h-px w-10 bg-line-strong'></span>
          <span class='eyebrow'>{eyebrow}</span>
          <span aria-hidden='true' class='h-px w-10 bg-line-strong'></span>
        </figcaption>
      )}
    </figure>
  </section>
)}
