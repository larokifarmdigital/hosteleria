---
import { t } from '@hosteleria/i18n-utils';
import { img } from '../lib/content';
import type { Restaurant, Espacio } from '../lib/queries';
import type { HoursUi } from '../lib/hours';
import { getLocation, telHref } from '../lib/location';
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  hours: HoursUi;
  locale: string;
  defaultLocale: string;
}

const { restaurant, espacio, hours, locale, defaultLocale } = Astro.props;
const heroImgUrl = img.url(espacio.heroImagen) ?? '/img/hero.jpg';
const bookingAction = resolveBookingAction(restaurant, locale);

const metaIzq = t(espacio.heroMetaIzq, locale, defaultLocale);
const metaDer = t(espacio.heroMetaDer, locale, defaultLocale);

const titulo = t(espacio.heroTitulo, locale, defaultLocale);
const emphasis = t(espacio.heroSubtitulo, locale, defaultLocale);

const { dir, mapsUrl, area } = getLocation(restaurant, locale);
const phone = restaurant.contacto?.telefono ?? '';

const T = {
  es: { menu: 'Ver la carta', directions: 'Cómo llegar', call: 'Llamar', info: 'Horario, dirección y teléfono' },
  ca: { menu: 'Veure la carta', directions: 'Com arribar', call: 'Trucar', info: 'Horari, adreça i telèfon' },
  en: { menu: 'View the menu', directions: 'Get directions', call: 'Call us', info: 'Opening hours, address and phone' }
};
const tt = T[locale as keyof typeof T] ?? T.es;

const cellCls =
  'group flex items-center gap-4 py-5 px-7 cursor-pointer transition-colors duration-200 hover:bg-surface-2/60 focus-visible:-outline-offset-4 focus-visible:rounded-[var(--radius-card)] max-[960px]:px-5 max-[960px]:py-4';
const cellIconCls =
  'flex items-center justify-center w-11 h-11 rounded-full bg-warm-soft text-accent shrink-0';
const cellLabelCls = 'block text-muted text-[13px] leading-snug';
const cellValueCls = 'block font-serif text-ink text-[19px] leading-snug tracking-[-0.005em]';
const cellArrowCls =
  'ml-auto text-accent opacity-60 transition-[opacity,transform] duration-200 group-hover:opacity-100 group-hover:translate-x-1';
---

<section id='top' class='relative w-full overflow-hidden bg-ink'>
  <!-- LCP: se precarga desde BaseLayout. Decorativa: el mensaje va en el h1. -->
  <img
    src={heroImgUrl}
    alt=''
    fetchpriority='high'
    decoding='async'
    class='hero-img absolute inset-0 w-full h-full object-cover'
  />
  <div
    aria-hidden='true'
    data-hero-veil
    class='absolute inset-0 bg-[linear-gradient(105deg,rgb(18_12_6/0.78)_0%,rgb(18_12_6/0.5)_45%,rgb(18_12_6/0.12)_80%),linear-gradient(to_top,rgb(18_12_6/0.6),transparent_45%)]'
  ></div>

  <div class='relative z-[1] px-(--gap)'>
  <div
    class='mx-auto max-w-[var(--max)] min-h-[min(88svh,860px)] flex flex-col justify-end
           pt-[calc(var(--nav-h)+56px)] pb-[clamp(96px,14vh,150px)]
           max-[960px]:min-h-[78svh] max-[960px]:pb-24'
  >
    <div class='flex flex-col gap-6 max-w-[720px]'>
      {hours.hasHours && (
        <!-- Estado de apertura: lo rellena HoursScript; sin JS no se muestra. -->
        <a href='#hours' data-open-status class='status-chip hero-in' style='--i:0'>
          <span class='status-dot' aria-hidden='true'></span>
          <span class='font-semibold' data-status-label></span>
          <span class='status-chip-detail' data-status-detail></span>
        </a>
      )}
      {(metaIzq || metaDer) && (
        <p style='--i:1' class='hero-in flex flex-wrap items-center gap-x-3 gap-y-1 text-white text-[12.5px] uppercase tracking-[0.16em] font-semibold'>
          {metaIzq && <span>{metaIzq}</span>}
          {metaIzq && metaDer && <span aria-hidden='true' class='w-6 h-px bg-warm-soft/70'></span>}
          {metaDer && <span class='text-warm-soft'>{metaDer}</span>}
        </p>
      )}

      <h1 style='--i:2' class='hero-in font-serif font-normal leading-[1.03] tracking-[-0.02em] text-[clamp(44px,6.4vw,88px)] text-white'>
        {titulo}
        {emphasis && <em class='block italic text-warm-soft'>{emphasis}</em>}
      </h1>

      <p
        style='--i:3'
        class='hero-in text-white/90 text-[clamp(17px,1.4vw,19px)] leading-[1.6] max-w-[44ch]'
        set:html={t(espacio.heroNota, locale, defaultLocale).replace(/\n/g, '<br />')}
      />

      <div style='--i:4' class='hero-in flex items-center gap-x-4 gap-y-3 flex-wrap mt-2'>
        {bookingAction && (
          <CtaButton
            href={bookingAction.href}
            target={bookingAction.external ? '_blank' : undefined}
            rel={bookingAction.external ? 'noopener' : undefined}
            variant='primary'
          >
            {t(espacio.heroCta, locale, defaultLocale)}
          </CtaButton>
        )}
        <CtaButton href='#plates' variant='ghostOnDark'>{tt.menu}</CtaButton>
      </div>
    </div>
  </div>
  </div>
</section>

<!-- Lo que más busca quien llega a la web de un bar: si está abierto, dónde
     está y cómo llamar. Monta sobre el borde inferior del hero. -->
<div class='relative z-[2] px-(--gap) bg-[linear-gradient(to_bottom,transparent_44px,var(--color-surface-2)_44px)]'>
  <ul
    aria-label={tt.info}
    style='--i:5'
    class='hero-in mx-auto max-w-[var(--max)] -mt-11 grid grid-cols-3 list-none overflow-hidden
           bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)]
           divide-x divide-line max-[960px]:grid-cols-1 max-[960px]:divide-x-0 max-[960px]:divide-y'
  >
    {hours.hasHours && (
      <li>
        <a href='#hours' class={cellCls}>
          <span class={cellIconCls}><Icon name='clock' /></span>
          <span class='min-w-0'>
            <span class:list={[cellValueCls, 'tabular-nums']} data-today-hours>{hours.strings.hours}</span>
            <span class={cellLabelCls}>{hours.strings.todayHours} · {hours.strings.fullWeek}</span>
          </span>
          <Icon name='arrow' size={18} class={cellArrowCls} />
        </a>
      </li>
    )}
    {dir.calle && (
      <li>
        <a href={mapsUrl || '#map'} target={mapsUrl ? '_blank' : undefined} rel={mapsUrl ? 'noopener' : undefined} class={cellCls}>
          <span class={cellIconCls}><Icon name='pin' /></span>
          <span class='min-w-0'>
            <span class={cellValueCls}>{dir.calle}</span>
            <span class={cellLabelCls}>{[area, tt.directions].filter(Boolean).join(' · ')}</span>
          </span>
          <Icon name='arrow' size={18} class={cellArrowCls} />
        </a>
      </li>
    )}
    {phone && (
      <li>
        <a href={telHref(phone)} class={cellCls}>
          <span class={cellIconCls}><Icon name='phone' /></span>
          <span class='min-w-0'>
            <span class:list={[cellValueCls, 'tabular-nums']}>{phone}</span>
            <span class={cellLabelCls}>{tt.call}</span>
          </span>
          <Icon name='arrow' size={18} class={cellArrowCls} />
        </a>
      </li>
    )}
  </ul>
</div>
