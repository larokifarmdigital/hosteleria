---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant, Espacio } from '../lib/queries';
import { buildHoursByDay } from '@hosteleria/utils';
import { bookingStrings } from '@hosteleria/booking-form';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import CtaButton from '../components/CtaButton.astro';
import { telHref } from '../lib/location';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  locale: string;
  defaultLocale: string;
  bookingEmail: string;
}

const { restaurant, espacio, locale, defaultLocale, bookingEmail } = Astro.props;

if (restaurant.aceptaReservas === false) return null;

const form = restaurant.textosForm ?? {};

const hoursByDay = buildHoursByDay(espacio.horariosSemana);
const pickerStrings = bookingStrings(locale);
const bookingConfig = {
  hoursByDay,
  strings: pickerStrings,
  bookingEmail,
  restaurantName: restaurant.nombre
};

// 16px en los campos: por debajo, iOS hace zoom al enfocar.
const fieldCls =
  'w-full min-h-[52px] bg-white border border-line-strong rounded-[10px] py-3 px-4 font-sans text-ink text-[16px] font-normal transition-[border-color,box-shadow] duration-200 hover:border-ink/40 focus:outline-none focus:border-accent focus:shadow-[0_0_0_4px_rgb(150_74_30/0.18)] placeholder:font-sans placeholder:text-dim';
const pickerBtnCls = `${fieldCls} text-left flex items-center justify-between gap-3 cursor-pointer`;
const labelCls = 'flex flex-col gap-2 font-sans text-ink font-semibold text-[14.5px]';
// empty:hidden y no display:none fijo: el aviso sigue en el árbol de accesibilidad
// y role=alert lo anuncia en cuanto se rellena.
const errorCls = 'text-[14px] font-medium text-[#a8321f] empty:hidden';
const popCls =
  'hidden absolute z-50 left-0 top-[calc(100%+8px)] max-w-full bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)] p-4 font-normal';

const phone = restaurant.contacto?.telefono ?? '';

const T = {
  es: {
    eyebrow: 'Reservas',
    optional: 'opcional',
    callTitle: '¿Prefieres llamar?',
    errName: 'Dinos a nombre de quién va la reserva',
    walkIn: 'También puedes venir sin reserva: si hay mesa, es tuya.'
  },
  ca: {
    eyebrow: 'Reserves',
    optional: 'opcional',
    callTitle: 'Prefereixes trucar?',
    errName: 'Digue’ns a nom de qui va la reserva',
    walkIn: 'També pots venir sense reserva: si hi ha taula, és teva.'
  },
  en: {
    eyebrow: 'Bookings',
    optional: 'optional',
    callTitle: 'Rather call?',
    errName: 'Tell us the name for the booking',
    walkIn: 'Walk-ins are welcome too: if there is a table, it is yours.'
  }
};
const tt = T[locale as keyof typeof T] ?? T.es;
---

<section id='book' class='section-y px-(--gap)'>
  <div
    class='mx-auto max-w-[var(--max)] grid grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] items-start gap-x-[clamp(40px,6vw,96px)] gap-y-8 max-[960px]:grid-cols-1'
  >
    <div>
      <SectionHeader
        eyebrow={tt.eyebrow}
        title={t(form.titulo, locale, defaultLocale) || 'Reserva tu mesa'}
        class='!mb-6'
      />
      <p class='text-muted text-[16.5px] leading-[1.7] max-w-[44ch]'>
        {t(form.intro, locale, defaultLocale)}
      </p>

      {phone && (
        <a
          href={telHref(phone)}
          class='mt-8 flex items-center gap-4 p-5 max-w-[420px] bg-surface border border-line rounded-[var(--radius-card)] cursor-pointer transition-[border-color,box-shadow] duration-200 hover:border-accent/60 hover:shadow-[var(--shadow-card)]'
        >
          <span class='flex items-center justify-center w-11 h-11 rounded-full bg-warm-soft text-accent shrink-0'>
            <Icon name='phone' />
          </span>
          <span class='min-w-0'>
            <span class='block text-muted text-[14px]'>{tt.callTitle}</span>
            <span class='block font-serif text-ink text-[21px] leading-snug tabular-nums'>{phone}</span>
          </span>
        </a>
      )}
      <p class='mt-5 text-muted text-[15px] leading-[1.6] max-w-[44ch]'>{tt.walkIn}</p>
    </div>

    <form
      id='reservaForm'
      novalidate
      data-err-name={tt.errName}
      class='reveal bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card)] p-9 grid grid-cols-2 gap-6 max-[700px]:grid-cols-1 max-[700px]:p-5'
    >
      <label class={labelCls}>
        <span>{t(form.labelNombre, locale, defaultLocale) || 'Nombre'}</span>
        <input type='text' name='nombre' required autocomplete='name' aria-describedby='err-nombre' class={fieldCls} />
        <span class={errorCls} id='err-nombre' role='alert' data-error-for='nombre'></span>
      </label>

      <label class={labelCls}>
        <span>{t(form.labelTelefono, locale, defaultLocale) || 'Teléfono'}</span>
        <input
          type='tel' name='telefono' required autocomplete='tel' inputmode='tel'
          placeholder='612 345 678' maxlength='17'
          aria-describedby='err-telefono' class={fieldCls} data-input-phone
        />
        <span class={errorCls} id='err-telefono' role='alert' data-error-for='telefono'></span>
      </label>

      <label class={labelCls}>
        <span>
          {t(form.labelEmail, locale, defaultLocale) || 'Email'}
          <span class='font-normal text-muted'> ({tt.optional})</span>
        </span>
        <input type='email' name='email' autocomplete='email' aria-describedby='err-email' class={fieldCls} data-input-email />
        <span class={errorCls} id='err-email' role='alert' data-error-for='email'></span>
      </label>

      <label class={labelCls}>
        <span>{t(form.labelComensales, locale, defaultLocale) || 'Comensales'}</span>
        <input
          type='text' name='personas' required inputmode='numeric' pattern='[0-9]{1,2}'
          maxlength='2' value='2'
          aria-describedby='err-personas' class={fieldCls} data-input-guests
        />
        <span class={errorCls} id='err-personas' role='alert' data-error-for='personas'></span>
      </label>

      <div class={labelCls}>
        <span id='bookDateLabel'>{t(form.labelFecha, locale, defaultLocale) || 'Fecha'}</span>
        <div class='relative'>
          <button type='button' class={pickerBtnCls} data-datepicker-btn aria-haspopup='dialog' aria-labelledby='bookDateLabel bookDateValue' aria-describedby='err-fecha'>
            <span id='bookDateValue' data-datepicker-label class='text-dim'>{pickerStrings.pickDate}</span>
            <Icon name='calendar' size={18} class='text-muted' />
          </button>
          <input type='hidden' name='fecha' required data-datepicker-input />
          <div data-datepicker-pop class:list={[popCls, 'w-[300px]']}></div>
        </div>
        <span class={errorCls} id='err-fecha' role='alert' data-error-for='fecha'></span>
      </div>

      <div class={labelCls}>
        <span id='bookTimeLabel'>{t(form.labelHora, locale, defaultLocale) || 'Hora'}</span>
        <div class='relative'>
          <button type='button' class={pickerBtnCls} data-timepicker-btn aria-haspopup='dialog' aria-labelledby='bookTimeLabel bookTimeValue' aria-describedby='err-hora'>
            <span id='bookTimeValue' data-timepicker-label class='text-dim'>{pickerStrings.pickTime}</span>
            <Icon name='clock' size={18} class='text-muted' />
          </button>
          <input type='hidden' name='hora' required data-timepicker-input />
          <div data-timepicker-pop class:list={[popCls, 'w-[320px]']}></div>
        </div>
        <span class={errorCls} id='err-hora' role='alert' data-error-for='hora'></span>
      </div>

      <label class:list={[labelCls, 'col-span-full']}>
        <span>{t(form.labelNotas, locale, defaultLocale) || 'Notas'}</span>
        <textarea name='notas' rows='3' class:list={[fieldCls, 'resize-y min-h-[104px] leading-normal']}></textarea>
      </label>

      <div class='col-span-full flex flex-wrap items-center gap-x-6 gap-y-3 mt-1'>
        <CtaButton type='submit' class='max-[700px]:w-full'>
          {t(form.submit, locale, defaultLocale) || 'Enviar'}
        </CtaButton>
        <p
          id='reservaMsg'
          role='status'
          aria-live='polite'
          class='flex-1 min-w-[200px] text-[15px] text-ink-soft empty:hidden'
        ></p>
      </div>
    </form>
  </div>
</section>

<script is:inline type='application/json' id='bookingConfig' set:html={JSON.stringify(bookingConfig)}></script>

<script>
  import { initBookingForm } from '@hosteleria/booking-form';
  initBookingForm();

  // El paquete compartido bloquea el envío sin nombre pero no avisa, y no lleva
  // el foco al primer error. Se completa aquí sin tocar el paquete.
  const form = document.querySelector<HTMLFormElement>('#reservaForm');
  const nameInput = form?.querySelector<HTMLInputElement>('input[name="nombre"]');
  const nameError = form?.querySelector<HTMLElement>('[data-error-for="nombre"]');
  if (form && nameInput && nameError) {
    nameInput.addEventListener('input', () => {
      if (nameInput.value.trim()) nameError.textContent = '';
    });
    form.addEventListener('submit', () => {
      nameError.textContent = nameInput.value.trim() ? '' : (form.dataset.errName ?? '');
      // Tras la validación del paquete (mismo evento), foco al primer campo con error.
      queueMicrotask(() => {
        const firstError = Array.from(form.querySelectorAll<HTMLElement>('[data-error-for]')).find(
          (el) => el.textContent?.trim()
        );
        if (!firstError) return;
        form.querySelector<HTMLElement>(`[aria-describedby~="${firstError.id}"]`)?.focus();
      });
    });
  }
</script>
