---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant, Espacio } from '../lib/queries';
import { buildHoursByDay } from '@hosteleria/utils';
import { bookingStrings } from '@hosteleria/booking-form';
import Eyebrow from '@hosteleria/ui/components/Eyebrow.astro';
import CtaButton from '../components/CtaButton.astro';

interface Props {
  restaurant: Restaurant;
  espacio: Espacio;
  locale: string;
  defaultLocale: string;
  bookingEmail: string;
}

const { restaurant, espacio, locale, defaultLocale, bookingEmail } = Astro.props;

if (restaurant.aceptaReservas === false) return null;

const nav = restaurant.textosNav ?? {};
const form = restaurant.textosForm ?? {};

const hoursByDay = buildHoursByDay(espacio.horariosSemana);
const tt = bookingStrings(locale);
const bookingConfig = {
  hoursByDay,
  strings: tt,
  bookingEmail,
  restaurantName: restaurant.nombre
};

// Estilo editorial: inputs con línea inferior fina (no cajas rounded).
// Inputs animados estilo card: fondo blanco, borde suave, focus ring warm.
const inputCls =
  'w-full bg-white border border-line rounded-xl py-3 px-4 font-sans text-ink text-[15px] font-normal transition-[border-color,box-shadow,background-color] duration-300 focus:outline-none focus:border-accent focus:shadow-[0_0_0_4px_rgb(150_96_0/0.14)] hover:border-ink/30 placeholder:text-dim';
const labelCls =
  'flex flex-col gap-2 font-sans text-ink font-semibold text-[12px] tracking-[0.02em]';
const errorCls =
  'text-[11.5px] font-normal text-accent italic hidden data-[error]:block';
const pickerBtnCls =
  'w-full bg-white border border-line rounded-xl py-3 px-4 font-sans text-ink text-[15px] font-normal text-left transition-[border-color,box-shadow,background-color] duration-300 hover:border-ink/30 focus:outline-none focus:border-accent focus:shadow-[0_0_0_4px_rgb(150_96_0/0.14)] flex items-center justify-between gap-3 cursor-pointer';

const titulo = t(form.titulo, locale, defaultLocale);
const [first, ...restTitle] = titulo.split(' ');
const restText = restTitle.join(' ');
---

<section id='book' class='relative overflow-hidden py-[16vh] px-(--gap) bg-surface-2 max-[960px]:py-[10vh]'>
  <div class='blob blob-warm w-[380px] h-[380px] -bottom-24 -right-20 max-[960px]:hidden'></div>

  <div class='relative z-[1] mx-auto max-w-[900px]'>
    <div class='reveal text-center mb-12'>
      <Eyebrow class='block mb-5'>{t(nav.linkReservar, locale, defaultLocale) || 'Reserva'}</Eyebrow>
      <h2 class='font-serif font-normal leading-[1.05] tracking-[-0.02em] text-[clamp(36px,4.4vw,60px)] text-ink mb-4'>
        <em class='italic text-warm font-normal'>{first}</em>{restText && ' ' + restText}
      </h2>
      <p class='text-muted text-[16px] leading-[1.7] mx-auto max-w-[52ch]'>
        {t(form.intro, locale, defaultLocale)}
      </p>
    </div>

    <form
      id='reservaForm'
      novalidate
      class='reveal bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card)] p-10 grid grid-cols-2 gap-y-7 gap-x-10 max-[960px]:grid-cols-1 max-[960px]:gap-6 max-[600px]:p-6'
    >
      <label class={labelCls}>
        <span>{t(form.labelNombre, locale, defaultLocale) || 'Nombre'}</span>
        <input type='text' name='nombre' required autocomplete='name' class={inputCls} />
      </label>

      <label class={labelCls}>
        <span>{t(form.labelTelefono, locale, defaultLocale) || 'Teléfono'}</span>
        <input
          type='tel' name='telefono' required autocomplete='tel' inputmode='tel'
          placeholder='612 345 678' maxlength='17'
          class={inputCls} data-input-phone
        />
        <span class={errorCls} data-error-for='telefono'></span>
      </label>

      <label class={labelCls}>
        <span>{t(form.labelEmail, locale, defaultLocale) || 'Email'}</span>
        <input
          type='email' name='email' autocomplete='email'
          placeholder='hola@ejemplo.com'
          class={inputCls} data-input-email
        />
        <span class={errorCls} data-error-for='email'></span>
      </label>

      <label class={labelCls}>
        <span>{t(form.labelComensales, locale, defaultLocale) || 'Comensales'}</span>
        <input
          type='text' name='personas' required inputmode='numeric' pattern='[0-9]{1,2}'
          maxlength='2' value='2' placeholder='2'
          class={inputCls} data-input-guests
        />
        <span class={errorCls} data-error-for='personas'></span>
      </label>

      <label class={labelCls}>
        <span>{t(form.labelFecha, locale, defaultLocale) || 'Fecha'}</span>
        <div class='relative'>
          <button type='button' class={pickerBtnCls} data-datepicker-btn>
            <span data-datepicker-label class='text-dim'>{tt.pickDate}</span>
            <svg width='15' height='15' viewBox='0 0 20 20' fill='none' aria-hidden='true' class='text-muted shrink-0'>
              <rect x='3' y='4' width='14' height='13' rx='1' stroke='currentColor' stroke-width='1.3' />
              <path d='M3 8h14M7 2v4M13 2v4' stroke='currentColor' stroke-width='1.3' stroke-linecap='round' />
            </svg>
          </button>
          <input type='hidden' name='fecha' required data-datepicker-input />
          <div
            data-datepicker-pop
            class='hidden absolute z-50 left-0 top-[calc(100%+8px)] w-[300px] bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)] p-4 max-[700px]:w-full max-[700px]:max-w-[320px]'
          ></div>
        </div>
        <span class={errorCls} data-error-for='fecha'></span>
      </label>

      <label class={labelCls}>
        <span>{t(form.labelHora, locale, defaultLocale) || 'Hora'}</span>
        <div class='relative'>
          <button type='button' class={pickerBtnCls} data-timepicker-btn>
            <span data-timepicker-label class='text-dim'>{tt.pickTime}</span>
            <svg width='15' height='15' viewBox='0 0 20 20' fill='none' aria-hidden='true' class='text-muted shrink-0'>
              <circle cx='10' cy='10' r='7' stroke='currentColor' stroke-width='1.3' />
              <path d='M10 6v4l2.5 2' stroke='currentColor' stroke-width='1.3' stroke-linecap='round' />
            </svg>
          </button>
          <input type='hidden' name='hora' required data-timepicker-input />
          <div
            data-timepicker-pop
            class='hidden absolute z-50 left-0 top-[calc(100%+8px)] w-[320px] bg-surface border border-line rounded-[var(--radius-card)] shadow-[var(--shadow-card-lift)] p-4 max-[700px]:w-full max-[700px]:max-w-[340px]'
          ></div>
        </div>
        <span class={errorCls} data-error-for='hora'></span>
      </label>

      <label class:list={[labelCls, 'col-span-full']}>
        <span>{t(form.labelNotas, locale, defaultLocale) || 'Notas'}</span>
        <textarea
          name='notas' rows='3'
          class:list={[inputCls, 'resize-y min-h-[110px] leading-normal']}
        ></textarea>
      </label>

      <div class='col-span-full flex justify-center mt-2'>
        <CtaButton type='submit'>
          {t(form.submit, locale, defaultLocale) || 'Enviar'}
        </CtaButton>
      </div>
      <p
        id='reservaMsg'
        role='status'
        aria-live='polite'
        class='col-span-full text-center min-h-[1.4em] text-[13px] tracking-[0.04em] text-muted'
      ></p>
    </form>
  </div>
</section>

<script is:inline type='application/json' id='bookingConfig' set:html={JSON.stringify(bookingConfig)}></script>

<script>
  import { initBookingForm } from '@hosteleria/booking-form';
  initBookingForm();
</script>
