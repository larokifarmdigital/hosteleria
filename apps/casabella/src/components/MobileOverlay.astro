---
import { t, localizedPath } from '@hosteleria/i18n-utils';
import type { LocaleRef, Restaurant } from '@hosteleria/sanity-client';
import IconClose from '@hosteleria/ui/icons/IconClose.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
  activeLocales: LocaleRef[];
  waHref: string;
  whatsappRaw: string;
  bookingPhone: string;
  bookingEmail: string;
  hrefPrefix?: string;
  langSwitcherPath?: string;
}

const {
  restaurant,
  locale,
  defaultLocale,
  activeLocales,
  waHref,
  whatsappRaw,
  bookingPhone,
  bookingEmail,
  hrefPrefix = '',
  langSwitcherPath = '/'
} = Astro.props;

const nav = restaurant.textosNav ?? {};

const A11Y: Record<string, { close: string; menu: string }> = {
  es: { close: 'Cerrar menú', menu: 'Menú' },
  en: { close: 'Close menu', menu: 'Menu' },
  ca: { close: 'Tancar menú', menu: 'Menú' }
};
const a11y = A11Y[locale] ?? A11Y.es;

const localesUi = activeLocales.length
  ? activeLocales
  : [{ codigo: defaultLocale, nombre: defaultLocale }];

const partes = restaurant.nombre.match(/^(Casa|La|El)?\s?(.*)$/);
const brandStart = partes?.[1] ?? '';
const brandRest = partes?.[2] ?? restaurant.nombre;

const links = [
  { href: `${hrefPrefix}#about`, label: t(nav.linkLocal, locale, defaultLocale) || 'Historia' },
  { href: `${hrefPrefix}#plates`, label: t(nav.linkCocina, locale, defaultLocale) || 'Carta' },
  { href: `${hrefPrefix}#wines`, label: t(nav.linkVinos, locale, defaultLocale) || 'Vinos' },
  { href: `${hrefPrefix}#gallery`, label: t(nav.linkGaleria, locale, defaultLocale) || 'Galería' }
];
const bookingAction = resolveBookingAction(restaurant, locale, hrefPrefix);
const reservarLabel = t(nav.linkReservar, locale, defaultLocale) || 'Reservar';
---

<!--
  Casabella MobileOverlay: editorial dark elegante. Look distinto del
  overlay de pubilla (que usa numeración recetario). Aquí protagonismo
  tipográfico total: links en serif Fraunces enormes sin numeración, CTA
  como link con arrow subrayado (no botón grande), separadores hairline,
  idiomas discretos junto al X. Animación limpia sin traba al cerrar.
-->
<div
  id='mobileOverlay'
  aria-hidden='true'
  data-open='false'
  class="fixed inset-0 z-[100] flex flex-col overflow-y-auto bg-bg
         py-6 px-(--gap) pb-10
         opacity-0 pointer-events-none -translate-y-3
         transition-[opacity,transform] duration-[260ms] ease-out
         data-[open='true']:opacity-100 data-[open='true']:pointer-events-auto data-[open='true']:translate-y-0
         motion-reduce:transition-none motion-reduce:duration-0"
>
  <!-- Header: brand a la izquierda + idiomas + X a la derecha -->
  <div class='flex justify-between items-center pb-8 border-b border-line/60'>
    <span class='font-serif text-ink font-light text-[24px] leading-none tracking-tight'>
      {
        brandStart ? (
          <>
            {brandStart}{' '}
            <em class='italic text-accent font-light'>{brandRest}</em>
          </>
        ) : (
          restaurant.nombre
        )
      }
    </span>

    <div class='flex items-center gap-5'>
      {
        localesUi.length > 1 && (
          <div
            aria-label='Idioma'
            class='flex gap-2 font-sans font-medium uppercase text-[10.5px] tracking-[0.26em] text-dim'
          >
            {localesUi.map((l, i) => (
              <>
                {i > 0 && <span class='opacity-50 -mx-0.5 select-none'>·</span>}
                <a
                  href={
                    l.codigo === locale
                      ? '#'
                      : localizedPath(langSwitcherPath, l.codigo, defaultLocale)
                  }
                  class:list={[
                    'py-1 transition-colors duration-300',
                    l.codigo === locale
                      ? 'text-accent pointer-events-none'
                      : 'hover:text-ink cursor-pointer'
                  ]}
                  aria-current={l.codigo === locale ? 'true' : undefined}
                >
                  {l.codigo.toUpperCase()}
                </a>
              </>
            ))}
          </div>
        )
      }
      <button
        id='mobileCloseBtn'
        aria-label={a11y.close}
        class='flex items-center justify-center w-11 h-11 -mr-2.5 bg-transparent border-none text-ink cursor-pointer transition-[color,transform] duration-300 hover:text-accent hover:rotate-90'
      >
        <IconClose />
      </button>
    </div>
  </div>

  <!-- Links: serif Fraunces enorme, sin numeración, hover con underline animado -->
  <nav aria-label={a11y.menu} class='flex-1 flex flex-col justify-center py-8'>
    {
      links.map((link, i) => (
        <a
          href={link.href}
          style={`--d: ${0.05 + i * 0.05}s`}
          class="group flex items-baseline gap-4 py-4
                 opacity-0 translate-y-3
                 transition-[opacity,transform] duration-[220ms] ease-out
                 cursor-pointer
                 group-data-[open='true']/overlay:opacity-100 group-data-[open='true']/overlay:translate-y-0 group-data-[open='true']/overlay:[transition-delay:var(--d)] group-data-[open='true']/overlay:duration-[420ms]
                 motion-reduce:transition-none motion-reduce:opacity-100 motion-reduce:translate-y-0"
        >
          <span class='font-serif font-light text-ink text-[clamp(38px,9vw,56px)] leading-[1.05] tracking-[-0.015em] transition-colors duration-300 group-hover:text-accent'>
            {link.label}
          </span>
        </a>
      ))
    }
  </nav>

  <!-- CTA como link con arrow (no botón grande) -->
  {bookingAction && (
    <div
      class="pt-6 pb-8 border-t border-line/60
             opacity-0 translate-y-3
             transition-[opacity,transform] duration-[220ms] ease-out
             group-data-[open='true']/overlay:opacity-100 group-data-[open='true']/overlay:translate-y-0
             group-data-[open='true']/overlay:[transition-delay:0.28s] group-data-[open='true']/overlay:duration-[420ms]
             motion-reduce:transition-none motion-reduce:opacity-100 motion-reduce:translate-y-0"
    >
      <a
        href={bookingAction.href}
        target={bookingAction.external ? '_blank' : undefined}
        rel={bookingAction.external ? 'noopener' : undefined}
        class='group inline-flex items-baseline gap-3 font-sans uppercase text-[12px] tracking-[0.28em] text-accent font-semibold border-b border-accent pb-1.5 transition-colors duration-300 hover:text-accent-hover hover:border-accent-hover cursor-pointer'
      >
        <span>{bookingAction.label ?? reservarLabel}</span>
        <span class='transition-transform duration-300 group-hover:translate-x-1'>→</span>
      </a>
    </div>
  )}

  <!-- Footer: contacto stack limpio, minimal -->
  <div class='flex flex-col gap-2 pt-6 border-t border-line/60'>
    {
      bookingPhone && (
        <a
          href={`tel:${bookingPhone}`}
          class='font-sans text-ink-soft text-[15px] transition-colors duration-300 hover:text-accent cursor-pointer'
        >
          {bookingPhone}
        </a>
      )
    }
    {
      waHref && (
        <a
          href={waHref}
          target='_blank'
          rel='noopener'
          class='font-sans text-ink-soft text-[15px] transition-colors duration-300 hover:text-accent cursor-pointer'
        >
          WhatsApp · {whatsappRaw}
        </a>
      )
    }
    {
      bookingEmail && (
        <a
          href={`mailto:${bookingEmail}`}
          class='font-sans text-ink-soft text-[15px] transition-colors duration-300 hover:text-accent cursor-pointer'
        >
          {bookingEmail}
        </a>
      )
    }
  </div>
</div>

<script is:inline>
  (function () {
    const hamburger = document.getElementById('hamburgerBtn');
    const closeBtn = document.getElementById('mobileCloseBtn');
    const overlay = document.getElementById('mobileOverlay');
    if (!hamburger || !overlay) return;

    overlay.classList.add('group/overlay');

    const setOpen = open => {
      overlay.dataset.open = open ? 'true' : 'false';
      document.body.classList.toggle('overlay-open', open);
      hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
      overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (open) closeBtn?.focus();
      else hamburger?.focus();
    };

    hamburger.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && overlay.dataset.open === 'true') setOpen(false);
    });

    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.onclick = e => {
        const target = a.getAttribute('href');
        if (target === '#') return;
        const el = document.querySelector(target);
        if (!el) return;
        e.preventDefault();
        const wasOpen = overlay.dataset.open === 'true';
        if (wasOpen) setOpen(false);
        setTimeout(
          () => el.scrollIntoView({ behavior: 'smooth', block: 'start' }),
          wasOpen ? 300 : 0
        );
      };
    });
  })();
</script>
