---
import { t, localizedPath } from '@hosteleria/i18n-utils';
import type { LocaleRef, Restaurant } from '@hosteleria/sanity-client';
import IconClose from '@hosteleria/ui/icons/IconClose.astro';
import { resolveBookingAction } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
  activeLocales: LocaleRef[];
  waHref: string;
  whatsappRaw: string;
  bookingPhone: string;
  bookingEmail: string;
  hrefPrefix?: string;
  langSwitcherPath?: string;
}

const {
  restaurant,
  locale,
  defaultLocale,
  activeLocales,
  waHref,
  whatsappRaw,
  bookingPhone,
  bookingEmail,
  hrefPrefix = '',
  langSwitcherPath = '/'
} = Astro.props;

const nav = restaurant.textosNav ?? {};

const A11Y: Record<string, { close: string; menu: string; nav: string; contact: string; language: string }> = {
  es: { close: 'Cerrar menú', menu: 'Menú',   nav: 'Navegación',  contact: 'Contacto', language: 'Idioma' },
  en: { close: 'Close menu',  menu: 'Menu',   nav: 'Navigation',  contact: 'Contact',  language: 'Language' },
  ca: { close: 'Tancar menú', menu: 'Menú',   nav: 'Navegació',   contact: 'Contacte', language: 'Idioma' }
};
const a11y = A11Y[locale] ?? A11Y.es;

const localesUi = activeLocales.length
  ? activeLocales
  : [{ codigo: defaultLocale, nombre: defaultLocale }];

const partes = restaurant.nombre.match(/^(Casa|La|El)?\s?(.*)$/);
const brandStart = partes?.[1] ?? '';
const brandRest = partes?.[2] ?? restaurant.nombre;

const links = [
  { href: `${hrefPrefix}#about`,   label: t(nav.linkLocal,   locale, defaultLocale) || 'Historia' },
  { href: `${hrefPrefix}#plates`,  label: t(nav.linkCocina,  locale, defaultLocale) || 'Carta' },
  { href: `${hrefPrefix}#wines`,   label: t(nav.linkVinos,   locale, defaultLocale) || 'Vinos' },
  { href: `${hrefPrefix}#gallery`, label: t(nav.linkGaleria, locale, defaultLocale) || 'Galería' }
];
const bookingAction = resolveBookingAction(restaurant, locale, hrefPrefix);
const reservarLabel = t(nav.linkReservar, locale, defaultLocale) || 'Reservar';
---

<!--
  MobileOverlay — versión editorial-restaurante: numeración serif tobacco,
  links serif grandes, dropdown de idiomas, CTA botón pill sobrio, bloque
  de contacto con iconos. Alineado al mismo lenguaje del nav desktop.
-->
<div
  id='mobileOverlay'
  aria-hidden='true'
  data-open='false'
  class="fixed inset-0 z-[100] flex flex-col overflow-y-auto bg-bg
         py-6 px-(--gap) pb-10
         opacity-0 pointer-events-none -translate-y-3
         transition-[opacity,transform] duration-[260ms] ease-out
         data-[open='true']:opacity-100 data-[open='true']:pointer-events-auto data-[open='true']:translate-y-0
         motion-reduce:transition-none motion-reduce:duration-0"
>
  <!-- Header: brand · dropdown idioma · botón cerrar -->
  <div class='flex justify-between items-center gap-4'>
    <span class='font-serif text-ink font-normal text-[26px] leading-none tracking-tight'>
      {
        brandStart ? (
          <>
            {brandStart}{' '}
            <em class='italic text-warm font-normal'>{brandRest}</em>
          </>
        ) : (
          restaurant.nombre
        )
      }
    </span>

    <div class='flex items-center gap-3'>
      {localesUi.length > 1 && (
        <details class='lang-dropdown-mobile group relative' aria-label={a11y.language}>
          <summary
            class='list-none [&::-webkit-details-marker]:hidden cursor-pointer
                   inline-flex items-center gap-2 py-1.5 px-3 rounded-md border border-line
                   font-sans font-semibold uppercase text-[11px] tracking-[0.22em] text-ink
                   hover:bg-surface-2 transition-colors duration-200'
          >
            <span>{locale.toUpperCase()}</span>
            <svg width='10' height='10' viewBox='0 0 12 12' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='transition-transform duration-300 group-open:rotate-180'>
              <path d='M3 4.5L6 7.5L9 4.5'/>
            </svg>
          </summary>
          <div class='absolute right-0 top-[calc(100%+6px)] min-w-[110px] bg-surface border border-line rounded-md overflow-hidden shadow-[var(--shadow-card-lift)] py-1 z-10'>
            {localesUi.map((l) => (
              <a
                href={
                  l.codigo === locale
                    ? '#'
                    : localizedPath(langSwitcherPath, l.codigo, defaultLocale)
                }
                class:list={[
                  'block px-4 py-2 font-sans font-semibold uppercase text-[11px] tracking-[0.22em] transition-colors duration-200',
                  l.codigo === locale
                    ? 'text-warm bg-surface-2 pointer-events-none'
                    : 'text-muted hover:text-ink hover:bg-surface-2 cursor-pointer'
                ]}
                aria-current={l.codigo === locale ? 'true' : undefined}
              >
                {l.codigo.toUpperCase()}
              </a>
            ))}
          </div>
        </details>
      )}
      <button
        id='mobileCloseBtn'
        aria-label={a11y.close}
        class='flex items-center justify-center w-11 h-11 -mr-2.5 bg-transparent border-none text-ink cursor-pointer transition-[color,transform] duration-300 hover:text-warm hover:rotate-90'
      >
        <IconClose />
      </button>
    </div>
  </div>

  <!-- Section label ── MENÚ ── (dashes warm) -->
  <div class='flex items-center gap-4 mt-8 mb-2 text-[10.5px] uppercase tracking-[0.32em] text-warm font-medium'>
    <span class='w-8 h-px bg-warm/50'></span>
    <span>{a11y.nav}</span>
    <span class='flex-1 h-px bg-warm/20'></span>
  </div>

  <!-- Links: serif Fraunces grandes + numeración warm 01/02/03/04 -->
  <nav aria-label={a11y.menu} class='flex-1 flex flex-col justify-center py-6'>
    {
      links.map((link, i) => (
        <a
          href={link.href}
          style={`--d: ${0.05 + i * 0.05}s`}
          class="group grid items-baseline grid-cols-[42px_1fr] gap-3 py-3.5 border-b border-line/50 last:border-b-0
                 opacity-0 translate-y-3
                 transition-[opacity,transform] duration-[220ms] ease-out
                 cursor-pointer
                 group-data-[open='true']/overlay:opacity-100 group-data-[open='true']/overlay:translate-y-0 group-data-[open='true']/overlay:[transition-delay:var(--d)] group-data-[open='true']/overlay:duration-[420ms]
                 motion-reduce:transition-none motion-reduce:opacity-100 motion-reduce:translate-y-0"
        >
          <span class='font-sans font-medium text-warm text-[11px] tracking-[0.24em] uppercase leading-none pb-1.5'>
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class='font-serif font-normal text-ink text-[clamp(34px,8vw,48px)] leading-[1.05] tracking-[-0.015em] transition-colors duration-300 group-hover:text-warm'>
            {link.label}
          </span>
        </a>
      ))
    }
  </nav>

  <!-- CTA botón pill grande, elegante -->
  {bookingAction && (
    <div
      class="pt-2 pb-6
             opacity-0 translate-y-3
             transition-[opacity,transform] duration-[220ms] ease-out
             group-data-[open='true']/overlay:opacity-100 group-data-[open='true']/overlay:translate-y-0
             group-data-[open='true']/overlay:[transition-delay:0.28s] group-data-[open='true']/overlay:duration-[420ms]
             motion-reduce:transition-none motion-reduce:opacity-100 motion-reduce:translate-y-0"
    >
      <a
        href={bookingAction.href}
        target={bookingAction.external ? '_blank' : undefined}
        rel={bookingAction.external ? 'noopener' : undefined}
        class='w-full flex items-center justify-center gap-3 py-4 px-6 bg-accent text-white rounded-full font-sans font-semibold uppercase text-[12px] tracking-[0.22em] transition-[background-color] duration-300 hover:bg-accent-hover cursor-pointer'
      >
        <span>{bookingAction.label ?? reservarLabel}</span>
        <span aria-hidden='true' class='transition-transform duration-300 group-hover:translate-x-1'>→</span>
      </a>
    </div>
  )}

  <!-- Contact block: label warm + stack con iconos -->
  <div class='pt-6 border-t border-line/70'>
    <div class='flex items-center gap-4 mb-4 text-[10.5px] uppercase tracking-[0.32em] text-warm font-medium'>
      <span class='w-8 h-px bg-warm/50'></span>
      <span>{a11y.contact}</span>
      <span class='flex-1 h-px bg-warm/20'></span>
    </div>

    <ul class='flex flex-col gap-3'>
      {bookingPhone && (
        <li>
          <a
            href={`tel:${bookingPhone}`}
            class='flex items-center gap-3.5 py-1 group cursor-pointer'
          >
            <span class='shrink-0 flex items-center justify-center w-9 h-9 rounded-full bg-surface border border-line text-warm transition-[background-color,border-color] duration-300 group-hover:bg-warm/10 group-hover:border-warm/40'>
              <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                <path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/>
              </svg>
            </span>
            <span class='font-sans text-ink-soft text-[15px] transition-colors duration-300 group-hover:text-ink'>
              {bookingPhone}
            </span>
          </a>
        </li>
      )}
      {waHref && whatsappRaw && (
        <li>
          <a
            href={waHref}
            target='_blank'
            rel='noopener'
            class='flex items-center gap-3.5 py-1 group cursor-pointer'
          >
            <span class='shrink-0 flex items-center justify-center w-9 h-9 rounded-full bg-surface border border-line text-warm transition-[background-color,border-color] duration-300 group-hover:bg-warm/10 group-hover:border-warm/40'>
              <svg width='14' height='14' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'>
                <path d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z'/>
              </svg>
            </span>
            <span class='font-sans text-ink-soft text-[15px] transition-colors duration-300 group-hover:text-ink'>
              {whatsappRaw}
            </span>
          </a>
        </li>
      )}
      {bookingEmail && (
        <li>
          <a
            href={`mailto:${bookingEmail}`}
            class='flex items-center gap-3.5 py-1 group cursor-pointer'
          >
            <span class='shrink-0 flex items-center justify-center w-9 h-9 rounded-full bg-surface border border-line text-warm transition-[background-color,border-color] duration-300 group-hover:bg-warm/10 group-hover:border-warm/40'>
              <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                <rect x='2' y='4' width='20' height='16' rx='2'/>
                <path d='M2 7l10 6 10-6'/>
              </svg>
            </span>
            <span class='font-sans text-ink-soft text-[15px] transition-colors duration-300 group-hover:text-ink break-all'>
              {bookingEmail}
            </span>
          </a>
        </li>
      )}
    </ul>
  </div>
</div>

<script is:inline>
  (function () {
    const hamburger = document.getElementById('hamburgerBtn');
    const closeBtn = document.getElementById('mobileCloseBtn');
    const overlay = document.getElementById('mobileOverlay');
    if (!hamburger || !overlay) return;

    overlay.classList.add('group/overlay');

    const setOpen = open => {
      overlay.dataset.open = open ? 'true' : 'false';
      document.body.classList.toggle('overlay-open', open);
      hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
      overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (open) closeBtn?.focus();
      else hamburger?.focus();
    };

    hamburger.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && overlay.dataset.open === 'true') setOpen(false);
    });

    // Cerrar dropdown de idioma al hacer click fuera
    const langDropdown = overlay.querySelector('.lang-dropdown-mobile');
    if (langDropdown) {
      overlay.addEventListener('click', (e) => {
        if (!langDropdown.contains(e.target)) langDropdown.removeAttribute('open');
      });
    }

    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.onclick = e => {
        const target = a.getAttribute('href');
        if (target === '#') return;
        const el = document.querySelector(target);
        if (!el) return;
        e.preventDefault();
        const wasOpen = overlay.dataset.open === 'true';
        if (wasOpen) setOpen(false);
        setTimeout(
          () => el.scrollIntoView({ behavior: 'smooth', block: 'start' }),
          wasOpen ? 300 : 0
        );
      };
    });
  })();
</script>
