---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string;
  variant?: "centered" | "split";
}

const {
  eyebrow,
  title,
  subtitle,
  ctaLabel = "Reservar mesa",
  ctaHref = "#reservar",
  secondaryLabel,
  secondaryHref,
  image,
  variant = "centered",
} = Astro.props;
---

{variant === "centered" ? (
  <section class="relative isolate overflow-hidden bg-paper">
    {image && (
      <div class="absolute inset-0 -z-10">
        <img src={image} alt="" class="h-full w-full object-cover opacity-30" />
      </div>
    )}
    <div class="mx-auto max-w-4xl px-6 py-24 md:py-36 text-center">
      {eyebrow && (
        <p class="mb-4 text-sm font-medium uppercase tracking-widest text-brand-600">
          {eyebrow}
        </p>
      )}
      <h1 class="font-serif text-5xl md:text-7xl font-semibold text-ink leading-tight">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-6 text-lg md:text-xl text-ink/70 max-w-2xl mx-auto">
          {subtitle}
        </p>
      )}
      <div class="mt-10 flex items-center justify-center gap-4 flex-wrap">
        <a
          href={ctaHref}
          class="rounded-full bg-brand-600 px-7 py-3 text-base font-medium text-white hover:bg-brand-700 transition-colors"
        >
          {ctaLabel}
        </a>
        {secondaryLabel && secondaryHref && (
          <a
            href={secondaryHref}
            class="rounded-full border border-ink/20 px-7 py-3 text-base font-medium text-ink hover:border-ink/50 transition-colors"
          >
            {secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </section>
) : (
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
      <div>
        {eyebrow && (
          <p class="mb-4 text-sm font-medium uppercase tracking-widest text-brand-600">
            {eyebrow}
          </p>
        )}
        <h1 class="font-serif text-4xl md:text-6xl font-semibold text-ink leading-tight">
          {title}
        </h1>
        {subtitle && (
          <p class="mt-6 text-lg text-ink/70">{subtitle}</p>
        )}
        <div class="mt-8 flex items-center gap-4 flex-wrap">
          <a
            href={ctaHref}
            class="rounded-full bg-brand-600 px-7 py-3 text-base font-medium text-white hover:bg-brand-700 transition-colors"
          >
            {ctaLabel}
          </a>
          {secondaryLabel && secondaryHref && (
            <a
              href={secondaryHref}
              class="rounded-full border border-ink/20 px-7 py-3 text-base font-medium text-ink hover:border-ink/50 transition-colors"
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      </div>
      {image && (
        <div class="relative">
          <img
            src={image}
            alt=""
            class="rounded-[var(--radius-card)] shadow-[var(--shadow-soft)] aspect-[4/5] object-cover w-full"
          />
        </div>
      )}
    </div>
  </section>
)}
