---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  brand: string;
  nav?: NavItem[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  brand,
  nav = [
    { label: "Carta", href: "#carta" },
    { label: "Nosotros", href: "#nosotros" },
    { label: "Contacto", href: "#contacto" },
  ],
  ctaLabel = "Reservar",
  ctaHref = "#reservar",
} = Astro.props;
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur border-b border-black/5">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-serif text-xl font-semibold text-ink">
      {brand}
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm text-ink/80 hover:text-brand-600 transition-colors"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={ctaHref}
      class="rounded-full bg-brand-600 px-5 py-2 text-sm font-medium text-white hover:bg-brand-700 transition-colors"
    >
      {ctaLabel}
    </a>
  </nav>
</header>
