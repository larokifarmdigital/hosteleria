---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  tone?: "light" | "dark";
}

const { id, eyebrow, title, subtitle, tone = "light" } = Astro.props;
---

<section
  id={id}
  class:list={[
    "py-20 md:py-28",
    tone === "dark" ? "bg-ink text-paper" : "bg-paper text-ink",
  ]}
>
  <div class="mx-auto max-w-6xl px-6">
    {(eyebrow || title || subtitle) && (
      <header class="mb-12 max-w-2xl">
        {eyebrow && (
          <p class="mb-3 text-sm font-medium uppercase tracking-widest text-brand-600">
            {eyebrow}
          </p>
        )}
        {title && (
          <h2 class="font-serif text-3xl md:text-5xl font-semibold leading-tight">
            {title}
          </h2>
        )}
        {subtitle && (
          <p class="mt-4 text-lg opacity-70">{subtitle}</p>
        )}
      </header>
    )}
    <slot />
  </div>
</section>
