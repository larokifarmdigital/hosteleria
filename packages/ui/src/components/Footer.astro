---
import { t } from '@hosteleria/i18n-utils';
import type { Restaurant, LegalPageDoc } from '@hosteleria/sanity-client';
import { buildHoursByDay, formatSchedule } from '@hosteleria/utils';

interface Props {
  restaurant: Restaurant;
  locale: string;
  defaultLocale: string;
  legalPages?: LegalPageDoc[];
  waHref: string;
  whatsappRaw: string;
  bookingPhone: string;
  bookingEmail: string;
  showCta?: boolean;
}

const {
  restaurant,
  locale,
  defaultLocale,
  legalPages = [],
  waHref,
  whatsappRaw,
  bookingPhone,
  bookingEmail,
  showCta = true
} = Astro.props;

const footerTexts = restaurant.textosFooter ?? {};
const dir = restaurant.direccion ?? {};

const mostrarRedes = restaurant.mostrarRedes === true;
const instagram = mostrarRedes ? (restaurant.redes?.instagram ?? '') : '';
const instagramHandle = instagram ? '@' + instagram.replace(/\/$/, '').split('/').pop() : '';

const rutaLegal = (slug: string) =>
  locale === defaultLocale ? `/legal/${slug}` : `/${locale}/legal/${slug}`;

const hoursByDay = buildHoursByDay(restaurant.horariosSemana);
const scheduleRows = formatSchedule(restaurant.horariosSemana, locale);
const openRows = scheduleRows.filter((r) => !r.closed);
const closedRows = scheduleRows.filter((r) => r.closed);
const closedLabel = closedRows.map((r) => r.label).join(', ');
const scheduleMessages = {
  abierto: t(restaurant.horariosAbierto, locale, defaultLocale) || 'Abierto hasta las {hora}.',
  proxima:
    t(restaurant.horariosProximaApertura, locale, defaultLocale) || 'Hoy abrimos a las {hora}.',
  cerrado: t(restaurant.horariosCerrado, locale, defaultLocale) || 'Cerrado.'
};

const T: Record<string, { cta: string; visit: string; contact: string; hours: string }> = {
  es: { cta: '¿Con ganas de mesa?', visit: 'Visítanos', contact: 'Contacto', hours: 'Horario' },
  en: { cta: 'Ready for a table?', visit: 'Visit us', contact: 'Contact', hours: 'Hours' },
  ca: { cta: 'Amb ganes de taula?', visit: 'Visita’ns', contact: 'Contacte', hours: 'Horari' }
};
const tt = T[locale] ?? T.es;
const byline = t(footerTexts.bylineIzq, locale, defaultLocale);

const h4Cls = 'uppercase text-accent font-medium text-[11px] tracking-[0.32em] mb-5';
const linkCls =
  'text-ink-soft text-[15px] leading-[1.9] transition-colors duration-300 hover:text-accent cursor-pointer';
---

<footer
  class='pt-[12vh] pb-[30px] px-(--gap) border-t border-line bg-surface max-[960px]:py-[8vh] max-[960px]:pb-[30px] [&_a]:cursor-pointer'
>
  {
    showCta && (
      <div class='mx-auto max-w-[var(--max)] mb-16 pb-12 border-b border-line flex flex-wrap items-center justify-between gap-8 max-[700px]:flex-col max-[700px]:items-start max-[700px]:gap-6 max-[960px]:mb-12'>
        <div class='flex flex-col gap-2'>
          <p class='font-serif font-light leading-none text-[clamp(28px,3.5vw,44px)]'>{tt.cta}</p>
          {byline && <p class='text-muted text-sm tracking-[0.02em]'>{byline}</p>}
        </div>
        <slot name='cta' />
      </div>
    )
  }

  <div
    class='grid mx-auto max-w-[var(--max)] mb-14 grid-cols-3 gap-[clamp(40px,6vw,80px)] max-[900px]:grid-cols-1 max-[900px]:gap-10 max-[900px]:mb-10'
  >
    <div>
      <h4 class={h4Cls}>{tt.visit}</h4>
      <p class='text-ink-soft text-[15px] leading-[1.9]'>
        {dir.calle}<br />
        {dir.codigoPostal}
        {dir.ciudad}<br />
        {
          dir.barrio && (
            <>
              {dir.barrio}
              <br />
            </>
          )
        }
      </p>
    </div>
    <div>
      <h4 class={h4Cls}>{tt.contact}</h4>
      {
        bookingPhone && (
          <p>
            <a href={`tel:${bookingPhone}`} class={linkCls}>
              {bookingPhone}
            </a>
          </p>
        )
      }
      {
        waHref && (
          <p>
            <a href={waHref} target='_blank' rel='noopener' class={linkCls}>
              WhatsApp · {whatsappRaw}
            </a>
          </p>
        )
      }
      {
        bookingEmail && (
          <p>
            <a href={`mailto:${bookingEmail}`} class={linkCls}>
              {bookingEmail}
            </a>
          </p>
        )
      }
    </div>
    <div>
      <h4 class={h4Cls}>{tt.hours}</h4>

      <p
        id='openLine'
        class='font-sans text-[13.5px] font-medium tracking-[0.02em] text-accent flex items-center gap-2 mb-4'
      >
        <span class='inline-block w-2 h-2 rounded-full bg-accent shrink-0'></span>
        <span>…</span>
      </p>

      <div class='flex flex-col gap-2 font-sans text-[13px] leading-[1.5] tabular-nums'>
        {openRows.map((row) => (
          <div>
            <div
              class:list={[
                'uppercase text-[10px] tracking-[0.2em] font-semibold mb-0.5',
                row.isToday ? 'text-accent' : 'text-muted'
              ]}
            >
              {row.label}
              {row.isToday && <span class='ml-1.5 text-[9px] opacity-70'>· HOY</span>}
            </div>
            <div class:list={[row.isToday ? 'text-ink font-medium' : 'text-ink-soft']}>
              {row.shifts.join(' · ')}
            </div>
          </div>
        ))}
        {closedLabel && (
          <div class='pt-2 mt-1 border-t border-line/50 flex items-baseline gap-2'>
            <span class='uppercase text-[10px] tracking-[0.2em] font-semibold text-dim'>
              {locale === 'en' ? 'Closed' : locale === 'ca' ? 'Tancat' : 'Cerrado'}
            </span>
            <span class='italic text-dim text-[12.5px]'>{closedLabel}</span>
          </div>
        )}
      </div>
    </div>
  </div>

  <div
    class='mx-auto max-w-[var(--max)] border-t border-line pt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-dim text-xs tracking-[0.04em] max-[700px]:flex-col max-[700px]:items-start'
  >
    {
      legalPages.length > 0 && (
        <div class='flex flex-wrap items-center gap-x-3 gap-y-2'>
          {legalPages.map((p, i) => (
            <>
              {i > 0 && <span class='opacity-40'>·</span>}
              <a
                href={rutaLegal(p.tipo)}
                class='hover:text-accent transition-colors duration-300 cursor-pointer'
              >
                {t(p.titulo, locale, defaultLocale)}
              </a>
            </>
          ))}
        </div>
      )
    }
    <div class='flex items-center gap-6 max-[700px]:gap-4'>
      {
        instagramHandle && (
          <a
            href={instagram}
            target='_blank'
            rel='noopener'
            class='hover:text-accent transition-colors duration-300 cursor-pointer'
          >
            {instagramHandle}
          </a>
        )
      }
      <span>© {new Date().getFullYear()} {restaurant.nombre}</span>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ hoursByDay, scheduleMessages }}>
  (function () {
    const HOURS = hoursByDay;
    const msg = scheduleMessages;
    const fmt = (n) => {
      const h = Math.floor(n);
      const m = Math.round((n - h) * 60);
      return `${h}:${m.toString().padStart(2, '0')}`;
    };
    const now = new Date();
    const d = now.getDay();
    const h = now.getHours() + now.getMinutes() / 60;
    const today = HOURS[d] || [];
    let open = false,
      nextOpen = null,
      closesAt = null;
    for (const [a, b] of today) {
      if (h >= a && h < b) {
        open = true;
        closesAt = b;
        break;
      }
      if (h < a && nextOpen === null) nextOpen = a;
    }
    const line = open
      ? msg.abierto.replace('{hora}', fmt(closesAt))
      : nextOpen !== null
        ? msg.proxima.replace('{hora}', fmt(nextOpen))
        : msg.cerrado;
    const el = document.getElementById('openLine');
    const textEl = el?.querySelector('span:last-child');
    if (textEl) textEl.textContent = line;
  })();
</script>
