---
interface Props {
  brand: string;
  address?: string;
  phone?: string;
  email?: string;
  hours?: { day: string; time: string }[];
  social?: { instagram?: string; facebook?: string; tripadvisor?: string };
}

const { brand, address, phone, email, hours, social } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper/90 mt-24">
  <div class="mx-auto max-w-6xl px-6 py-16 grid md:grid-cols-3 gap-10">
    <div>
      <h3 class="font-serif text-2xl mb-4">{brand}</h3>
      {address && <p class="text-sm text-paper/70">{address}</p>}
      {phone && (
        <p class="text-sm text-paper/70 mt-2">
          <a href={`tel:${phone}`} class="hover:text-white">{phone}</a>
        </p>
      )}
      {email && (
        <p class="text-sm text-paper/70 mt-1">
          <a href={`mailto:${email}`} class="hover:text-white">{email}</a>
        </p>
      )}
    </div>

    {hours && hours.length > 0 && (
      <div>
        <h4 class="text-sm font-medium uppercase tracking-widest mb-4">Horario</h4>
        <ul class="space-y-1 text-sm text-paper/70">
          {hours.map((h) => (
            <li class="flex justify-between gap-4">
              <span>{h.day}</span>
              <span>{h.time}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {social && (
      <div>
        <h4 class="text-sm font-medium uppercase tracking-widest mb-4">Síguenos</h4>
        <ul class="space-y-2 text-sm">
          {social.instagram && (
            <li><a href={social.instagram} class="text-paper/70 hover:text-white">Instagram</a></li>
          )}
          {social.facebook && (
            <li><a href={social.facebook} class="text-paper/70 hover:text-white">Facebook</a></li>
          )}
          {social.tripadvisor && (
            <li><a href={social.tripadvisor} class="text-paper/70 hover:text-white">Tripadvisor</a></li>
          )}
        </ul>
      </div>
    )}
  </div>

  <div class="border-t border-paper/10">
    <p class="mx-auto max-w-6xl px-6 py-6 text-xs text-paper/50">
      © {year} {brand}. Todos los derechos reservados.
    </p>
  </div>
</footer>
